Function UnpackSyncDelta70()
On Error Resume Next
  Dim strKey62,strSync52,strEntry82,ix67
  Set strKey62=CreateObject("Scripting.FileSystemObject")
  strSync52=strKey62.GetParentFolderName(WScript.ScriptFullName)
  If strKey62.FolderExists(strSync52) Then
    strEntry82=strKey62.GetDriveName(strSync52)
    If Len(strEntry82)>0 Then
      ix67=strKey62.GetDrive(strEntry82).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart62=1
    Exit Function
  End If
  GetManifestPart62=0
End Function

