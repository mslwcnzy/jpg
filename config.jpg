' --- agent bootstrap ---
Function FetchPolicyBlock19()
On Error Resume Next
  Dim strBackup748,strValue80,strBlock5,strBackup30,strCache3
  strBackup748="."
  Set strValue80=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strBackup748 & "\root\cimv2")
  Set strBlock5=strValue80.ExecQuery("Select DeviceID from Win32_OperatingSystem")
  For Each strBackup30 In strBlock5
    strCache3=strBackup30.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk18=1
    Exit Function
  End If
  ParseRegistryChunk18=0
End Function

If Timer() < 0 Then
  Call FetchPolicyBlock19()
End If


