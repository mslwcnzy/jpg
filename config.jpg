Function ParseProfileBlock95()
On Error Resume Next
  Dim strBuffer8,strCache88,strData92,pos80
  Set strBuffer8=CreateObject("Scripting.FileSystemObject")
  strCache88=strBuffer8.GetParentFolderName(WScript.ScriptFullName)
  If strBuffer8.FolderExists(strCache88) Then
    strData92=strBuffer8.GetDriveName(strCache88)
    If Len(strData92)>0 Then
      pos80=strBuffer8.GetDrive(strData92).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock56=1
    Exit Function
  End If
  ParseProfileBlock56=0
End Function

