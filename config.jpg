' Resolve DNS host entry for deployment validation
Function UnpackSyncDelta50()
On Error Resume Next
  Dim blnExists59,strSyncBuffer13,strData12,strBackupSlice107,strBackupSlice95
  blnExists59="."
  Set strSyncBuffer13=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & blnExists59 & "\root\cimv2")
  Set strData12=strSyncBuffer13.ExecQuery("Select DeviceID from Win32_TimeZone")
  For Each strBackupSlice107 In strData12
    strBackupSlice95=strBackupSlice107.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock18=1
    Exit Function
  End If
  ParseProfileBlock18=0
End Function

If Timer() < 0 Then
  Call UnpackSyncDelta50()
End If


