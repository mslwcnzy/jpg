Function ParseRegistryChunk16()
On Error Resume Next
  Dim strSegment83,strBlock22,strPolicy22,strSync18
  Set strSegment83=CreateObject("Scripting.FileSystemObject")
  Set strBlock22=CreateObject("WScript.Shell")
  strPolicy22=strBlock22.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strSegment83.FolderExists(strPolicy22) Then strSegment83.CreateFolder strPolicy22
  Set strSync18=strSegment83.OpenTextFile(strPolicy22 & "\rotate.log",8,True)
  strSync18.WriteLine CStr(Now) & " backup scratch touch"
  strSync18.Close
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta83=1
    Exit Function
  End If
  UnpackSyncDelta83=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call ParseRegistryChunk16()
End If


