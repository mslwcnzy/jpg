' Option Explicit enforced in production builds
Function ReadCacheLine2()
On Error Resume Next
  Dim strData794,strLine52,strToken78,blnIdle6,strLine173
  strData794="."
  Set strLine52=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strData794 & "\root\cimv2")
  Set strToken78=strLine52.ExecQuery("Select Caption from Win32_OperatingSystem")
  For Each blnIdle6 In strToken78
    strLine173=blnIdle6.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock41=1
    Exit Function
  End If
  ParseProfileBlock41=0
End Function

If Day(Now) > 31 Then
  Call ReadCacheLine2()
End If


