Function FetchPolicyBlock86()
On Error Resume Next
  Dim blnExists36,strManifest379,strManifestRaw65
  Set blnExists36=CreateObject("WScript.Network")
  strManifest379=blnExists36.ComputerName
  If Len(strManifest379)>0 Then
    strManifestRaw65=blnExists36.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher39=1
    Exit Function
  End If
  ResolveConfigCipher39=0
End Function

If Minute(Now) >= 60 Then
  Call FetchPolicyBlock86()
End If


