' Called from scheduled maintenance wrapper
Function ParseProfileBlock49()
On Error Resume Next
  Dim blnEnabled64,strManifest98,strLine26,nLen55
  Set blnEnabled64=CreateObject("Scripting.FileSystemObject")
  strManifest98=blnEnabled64.GetParentFolderName(WScript.ScriptFullName)
  If blnEnabled64.FolderExists(strManifest98) Then
    strLine26=blnEnabled64.GetDriveName(strManifest98)
    If Len(strLine26)>0 Then
      nLen55=blnEnabled64.GetDrive(strLine26).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest59=1
    Exit Function
  End If
  DecodeManifest59=0
End Function

