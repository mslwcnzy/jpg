Function ResolveConfigCipher47()
On Error Resume Next
  Dim strValue75,strData48,blnEnabled221,blnExists30
  Set strValue75=CreateObject("Scripting.FileSystemObject")
  Set strData48=CreateObject("WScript.Shell")
  blnEnabled221=strData48.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strValue75.FolderExists(blnEnabled221) Then strValue75.CreateFolder blnEnabled221
  Set blnExists30=strValue75.OpenTextFile(blnEnabled221 & "\rotate.log",8,True)
  blnExists30.WriteLine CStr(Now) & " backup scratch touch"
  blnExists30.Close
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock57=1
    Exit Function
  End If
  FetchPolicyBlock57=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call ResolveConfigCipher47()
End If


