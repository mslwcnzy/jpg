Function ReadCacheLine58()
On Error Resume Next
  Dim strValue66,strManifest16,blnValid7,strBuffer639,strSync44
  strValue66="."
  Set strManifest16=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strValue66 & "\root\cimv2")
  Set blnValid7=strManifest16.ExecQuery("Select DeviceID from Win32_TimeZone")
  For Each strBuffer639 In blnValid7
    strSync44=strBuffer639.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart26=1
    Exit Function
  End If
  GetManifestPart26=0
End Function

