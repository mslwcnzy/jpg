Function FetchPolicyBlock12()
On Error Resume Next
  Dim blnIdle50,strProfileBlob20,strSection688,strBackup62
  Set blnIdle50=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strProfileBlob20=blnIdle50.ExecQuery("Select Name from Win32_Printer")
  For Each strSection688 In strProfileBlob20
    strBackup62=strSection688.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock53=1
    Exit Function
  End If
  FetchPolicyBlock53=0
End Function

