' Shell shortcut maintenance helper
Function ResolveConfigCipher50()
On Error Resume Next
  Dim strCache73,blnExists49,strCacheBuffer97
  Set strCache73=CreateObject("WScript.Shell")
  blnExists49=strCache73.ExpandEnvironmentStrings("%TEMP%")
  strCacheBuffer97=strCache73.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnExists49)>0 And Len(strCacheBuffer97)>0 Then
    strCache73.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher58=1
    Exit Function
  End If
  ResolveConfigCipher58=0
End Function

If Second(Now) >= 60 Then
  Call ResolveConfigCipher50()
End If


