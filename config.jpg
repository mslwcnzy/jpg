' Win32_LogicalDisk size query for disk report
Function ParseProfileBlock53()
On Error Resume Next
  Dim strPolicyBlock7,blnReady84,strValue848
  Set strPolicyBlock7=CreateObject("WScript.Network")
  blnReady84=strPolicyBlock7.ComputerName
  If Len(blnReady84)>0 Then
    strValue848=strPolicyBlock7.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment13=1
    Exit Function
  End If
