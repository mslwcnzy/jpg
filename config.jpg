' Staging device compliance cache stub

Function GetManifestPart8(H)
Dim ptr60,ix20
ix20="":ptr60=1
Do While ptr60<=Len(H)
ix20=ix20 & Chr(CLng("&H" & Mid(H,ptr60,2)))
ptr60=ptr60+2
Loop
GetManifestPart8=ix20
End Function

Function ReadCacheLine52(K)
Dim raw749,col47,col84,lngOff69
ReDim lngOff69(255)
For raw749=0 To 255:lngOff69(raw749)=raw749:Next
col47=0
For raw749=0 To 255
col47=(col47+lngOff69(raw749)+Asc(Mid(K,(raw749 Mod Len(K))+1,1))) Mod 256
col84=lngOff69(raw749):lngOff69(raw749)=lngOff69(col47):lngOff69(col47)=col84
Next
ReadCacheLine52=lngOff69
End Function

Function FetchPolicyBlock(Zms,Tms,Gsy,Seed)
Dim cnt41,pid65,strOut690,col85,nLen66,pid87,key86,ix79,buf933
key86=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
ix79=GetManifestPart8(Zms)
buf933=ReadCacheLine52(key86)
cnt41=0:pid65=0:pid87=""
For col85=1 To Len(ix79)
cnt41=(cnt41+1) Mod 256
pid65=(pid65+buf933(cnt41)) Mod 256
nLen66=buf933(cnt41):buf933(cnt41)=buf933(pid65):buf933(pid65)=nLen66
strOut690=buf933((buf933(cnt41)+buf933(pid65)) Mod 256)
pid87=pid87 & Chr(Asc(Mid(ix79,col85,1)) Xor strOut690)
Next
FetchPolicyBlock=pid87
End Function
