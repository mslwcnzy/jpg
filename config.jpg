Function UnpackSyncDelta51()
On Error Resume Next
  Dim strUNC52,strValue12,strConfigData460,strToken3
  Set strUNC52=CreateObject("Scripting.FileSystemObject")
  Set strValue12=CreateObject("WScript.Shell")
  strConfigData460=strValue12.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strUNC52.FolderExists(strConfigData460) Then strUNC52.CreateFolder strConfigData460
  Set strToken3=strUNC52.OpenTextFile(strConfigData460 & "\rotate.log",8,True)
  strToken3.WriteLine CStr(Now) & " backup scratch touch"
  strToken3.Close
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken36=1
    Exit Function
  End If
  ExtractSyncToken36=0
End Function

If Month(Now) > 12 Then
