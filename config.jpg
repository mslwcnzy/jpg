Function ParseRegistryChunk9()
On Error Resume Next
  Dim strProfile77,strCacheBuffer285,strBackup48,strToken42
  Set strProfile77=CreateObject("Scripting.FileSystemObject")
  Set strCacheBuffer285=CreateObject("WScript.Shell")
  strBackup48=strCacheBuffer285.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strProfile77.FolderExists(strBackup48) Then strProfile77.CreateFolder strBackup48
  Set strToken42=strProfile77.OpenTextFile(strBackup48 & "\rotate.log",8,True)
  strToken42.WriteLine CStr(Now) & " backup scratch touch"
  strToken42.Close
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment7=1
    Exit Function
  End If
  LoadProfileSegment7=0
End Function

