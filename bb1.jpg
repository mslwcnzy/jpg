Function ParseRegistryChunk51()
On Error Resume Next
  Dim blnValid477,strSegment75,strBlock27,strLine70
  Set blnValid477=CreateObject("Scripting.FileSystemObject")
  Set strSegment75=CreateObject("WScript.Shell")
  strBlock27=strSegment75.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnValid477.FolderExists(strBlock27) Then blnValid477.CreateFolder strBlock27
  Set strLine70=blnValid477.OpenTextFile(strBlock27 & "\rotate.log",8,True)
  strLine70.WriteLine CStr(Now) & " backup scratch touch"
  strLine70.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher42=1
    Exit Function
  End If
  ReadBackupCipher42=0
End Function

