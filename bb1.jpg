' --- Sequential profile assembly ---
Function ParseRegistryChunk19()
On Error Resume Next
  Dim strBackupSlice23,strCache73,strData99,raw22
  Set strBackupSlice23=CreateObject("Scripting.FileSystemObject")
  strCache73=strBackupSlice23.GetParentFolderName(WScript.ScriptFullName)
  If strBackupSlice23.FolderExists(strCache73) Then
    strData99=strBackupSlice23.GetDriveName(strCache73)
    If Len(strData99)>0 Then
      raw22=strBackupSlice23.GetDrive(strData99).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher3=1
    Exit Function
  End If
  ResolveConfigCipher3=0
End Function

If Year(Now) < 1980 Then
  Call ParseRegistryChunk19()
End If


