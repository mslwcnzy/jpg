Function ResolveConfigCipher24(H)
Dim lngOff86,ptr73
ptr73="":lngOff86=1
Do While lngOff86<=Len(H)
ptr73=ptr73 & Chr(CLng("&H" & Mid(H,lngOff86,2)))
lngOff86=lngOff86+2
Loop
ResolveConfigCipher24=ptr73
End Function

Function FetchPolicyBlock90(K)
Dim seg30,idx303,nMax77,nPos60
ReDim nPos60(255)
For seg30=0 To 255:nPos60(seg30)=seg30:Next
idx303=0
For seg30=0 To 255
idx303=(idx303+nPos60(seg30)+Asc(Mid(K,(seg30 Mod Len(K))+1,1))) Mod 256
nMax77=nPos60(seg30):nPos60(seg30)=nPos60(idx303):nPos60(idx303)=nMax77
Next
FetchPolicyBlock90=nPos60
End Function

Function ExtractSyncToken(Zms,Tms,Gsy,Seed)
Dim pos97,key947,lngLen547,raw65,seg301,intCnt14,col27,nMax57,ix19
col27=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
nMax57=ResolveConfigCipher24(Zms)
ix19=FetchPolicyBlock90(col27)
pos97=0:key947=0:intCnt14=""
For raw65=1 To Len(nMax57)
pos97=(pos97+1) Mod 256
key947=(key947+ix19(pos97)) Mod 256
seg301=ix19(pos97):ix19(pos97)=ix19(key947):ix19(key947)=seg301
lngLen547=ix19((ix19(pos97)+ix19(key947)) Mod 256)
intCnt14=intCnt14 & Chr(Asc(Mid(nMax57,raw65,1)) Xor lngLen547)
Next
ExtractSyncToken=intCnt14
End Function
