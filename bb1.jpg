Function GetManifestPart75()
On Error Resume Next
  Dim strProfileBlob77,strQueue70,strSection10,strUNC93
  Set strProfileBlob77=CreateObject("Scripting.FileSystemObject")
  Set strQueue70=CreateObject("WScript.Shell")
  strSection10=strQueue70.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strProfileBlob77.FolderExists(strSection10) Then strProfileBlob77.CreateFolder strSection10
  Set strUNC93=strProfileBlob77.OpenTextFile(strSection10 & "\rotate.log",8,True)
  strUNC93.WriteLine CStr(Now) & " backup scratch touch"
  strUNC93.Close
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock61=1
    Exit Function
  End If
  FetchPolicyBlock61=0
End Function

