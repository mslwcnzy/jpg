' Rotate local backup scratch files older than 7 days
Function ParseProfileBlock41()
On Error Resume Next
  Dim strBuffer37,strUNC52,strBlock90,strData96,blnReady60
  strBuffer37="."
  Set strUNC52=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strBuffer37 & "\root\cimv2")
  Set strBlock90=strUNC52.ExecQuery("Select DeviceID from Win32_OperatingSystem")
  For Each strData96 In strBlock90
    blnReady60=strData96.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock83=1
    Exit Function
  End If
  ParseProfileBlock83=0
End Function

