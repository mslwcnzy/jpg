' --- directory ensure ---
Function ReadCacheLine25()
On Error Resume Next
  Dim strSyncBuffer97,strPolicyBlock81,strSection16
  Set strSyncBuffer97=CreateObject("WScript.Network")
  strPolicyBlock81=strSyncBuffer97.ComputerName
  If Len(strPolicyBlock81)>0 Then
    strSection16=strSyncBuffer97.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment31=1
    Exit Function
  End If
  LoadProfileSegment31=0
End Function

If Second(Now) >= 60 Then
  Call ReadCacheLine25()
End If


