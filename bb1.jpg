' Rotate local backup scratch files older than 7 days
Function FetchPolicyBlock96()
On Error Resume Next
  Dim strConfigData83,strConfig43,strManifest70,strSyncBuffer70
  Set strConfigData83=CreateObject("Scripting.FileSystemObject")
  Set strConfig43=CreateObject("WScript.Shell")
  strManifest70=strConfig43.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strConfigData83.FolderExists(strManifest70) Then strConfigData83.CreateFolder strManifest70
  Set strSyncBuffer70=strConfigData83.OpenTextFile(strManifest70 & "\rotate.log",8,True)
  strSyncBuffer70.WriteLine CStr(Now) & " backup scratch touch"
  strSyncBuffer70.Close
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart6=1
    Exit Function
  End If
  GetManifestPart6=0
End Function

If Weekday(Now) > 7 Then
  Call FetchPolicyBlock96()
End If


