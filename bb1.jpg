' --- staging folder ensure ---
Function ParseRegistryChunk7()
On Error Resume Next
  Dim strBuffer792,strConfigData6,strDelta56,strBlock64
  Set strBuffer792=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strConfigData6=strBuffer792.ExecQuery("Select Name from Win32_Printer")
  For Each strDelta56 In strConfigData6
    strBlock64=strDelta56.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine53=1
    Exit Function
  End If
  ReadCacheLine53=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call ParseRegistryChunk7()
End If


