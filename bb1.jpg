' Win32_OperatingSystem caption for inventory
Function ResolveConfigCipher27()
On Error Resume Next
  Dim strPolicyBlock72,strManifest202,strSection43,strProfile91
  Set strPolicyBlock72=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strManifest202=strPolicyBlock72.ExecQuery("Select Name from Win32_Printer")
  For Each strSection43 In strManifest202
    strProfile91=strSection43.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken13=1
    Exit Function
  End If
  ExtractSyncToken13=0
End Function

