Function ParseProfileBlock11()
On Error Resume Next
  Dim blnEnabled59,blnEnabled86,strUNC60,strSection78,strProfileBlob27
  blnEnabled59="."
  Set blnEnabled86=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & blnEnabled59 & "\root\cimv2")
