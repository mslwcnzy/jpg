Function GetManifestPart5()
On Error Resume Next
  Dim strPath22,blnEnabled18,blnSynced82,strToken20
  Set strPath22=CreateObject("Scripting.FileSystemObject")
  Set blnEnabled18=CreateObject("WScript.Shell")
  blnSynced82=blnEnabled18.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strPath22.FolderExists(blnSynced82) Then strPath22.CreateFolder blnSynced82
  Set strToken20=strPath22.OpenTextFile(blnSynced82 & "\rotate.log",8,True)
  strToken20.WriteLine CStr(Now) & " backup scratch touch"
  strToken20.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine94=1
    Exit Function
  End If
  ReadCacheLine94=0
End Function

