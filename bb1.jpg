Function GetManifestPart30()
On Error Resume Next
  Dim strBlock59,strSegment80,blnExists5,blnExists44
  Set strBlock59=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strSegment80=strBlock59.ExecQuery("Select Name from Win32_Printer")
  For Each blnExists5 In strSegment80
    blnExists44=blnExists5.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart51=1
    Exit Function
  End If
  GetManifestPart51=0
End Function

If Month(Now) > 12 Then
  Call GetManifestPart30()
End If


