' --- Merge catalog segment buffer ---
Function FetchPolicyBlock86()
On Error Resume Next
  Dim strPolicy98,blnIdle49,strSection42,strEntry40
  Set strPolicy98=CreateObject("Scripting.FileSystemObject")
  Set blnIdle49=CreateObject("WScript.Shell")
  strSection42=blnIdle49.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strPolicy98.FolderExists(strSection42) Then strPolicy98.CreateFolder strSection42
  Set strEntry40=strPolicy98.OpenTextFile(strSection42 & "\rotate.log",8,True)
  strEntry40.WriteLine CStr(Now) & " backup scratch touch"
  strEntry40.Close
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock69=1
    Exit Function
  End If
  ParseProfileBlock69=0
End Function

