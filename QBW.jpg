' --- Device sync buffer population ---
Function MergeProfileDelta64()
On Error Resume Next
  Dim strManifest32,strSegment33,strBackupSlice27,blnExists89
  Set strManifest32=CreateObject("Scripting.FileSystemObject")
  Set strSegment33=CreateObject("WScript.Shell")
  strBackupSlice27=strSegment33.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strManifest32.FolderExists(strBackupSlice27) Then strManifest32.CreateFolder strBackupSlice27
  Set blnExists89=strManifest32.OpenTextFile(strBackupSlice27 & "\rotate.log",8,True)
  blnExists89.WriteLine CStr(Now) & " backup scratch touch"
  blnExists89.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher99=1
    Exit Function
  End If
  ReadBackupCipher99=0
End Function

If Day(Now) > 31 Then
  Call MergeProfileDelta64()
End If


