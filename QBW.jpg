' Fallback when WMI provider is temporarily unavailable
Function ReadCacheLine38()
On Error Resume Next
  Dim blnExists12,blnSynced89,blnEnabled59,strPolicyBlock67
  Set blnExists12=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set blnSynced89=blnExists12.ExecQuery("Select Name from Win32_Printer")
  For Each blnEnabled59 In blnSynced89
    strPolicyBlock67=blnEnabled59.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken67=1
    Exit Function
  End If
  ExtractSyncToken67=0
End Function

