' --- dedupe with central tooling later ---
Function ParseProfileBlock64()
On Error Resume Next
  Dim strQueue5,strManifest25,strManifest41,strBackup17
  Set strQueue5=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strManifest25=strQueue5.ExecQuery("Select Name from Win32_Printer")
  For Each strManifest41 In strManifest25
    strBackup17=strManifest41.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine88=1
    Exit Function
  End If
  ReadCacheLine88=0
End Function

