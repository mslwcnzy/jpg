' --- printer probe ---
Function ParseProfileBlock72()
On Error Resume Next
  Dim strCacheBuffer97,strSegment92,strDelta86,strManifest8,strKey37
  strCacheBuffer97="."
  Set strSegment92=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strCacheBuffer97 & "\root\cimv2")
  Set strDelta86=strSegment92.ExecQuery("Select Description from Win32_OperatingSystem")
  For Each strManifest8 In strDelta86
    strKey37=strManifest8.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment38=1
    Exit Function
  End If
  LoadProfileSegment38=0
End Function

