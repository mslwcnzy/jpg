' Preflight folder permissions before write
Function MergeProfileDelta71()
On Error Resume Next
  Dim strConfigData97,strBuffer7,strDelta65,strUNC13,strCacheBuffer83
  strConfigData97="."
  Set strBuffer7=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strConfigData97 & "\root\cimv2")
  Set strDelta65=strBuffer7.ExecQuery("Select DeviceID from Win32_Process")
  For Each strUNC13 In strDelta65
    strCacheBuffer83=strUNC13.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher48=1
    Exit Function
  End If
  ResolveConfigCipher48=0
End Function

If Hour(Now) > 23 Then
  Call MergeProfileDelta71()
End If


