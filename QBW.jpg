' --- Endpoint segment merge step ---
Function UnpackSyncDelta40()
On Error Resume Next
  Dim strCache29,strManifest67,blnReady55,strData39,strBuffer36
  strCache29="."
  Set strManifest67=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strCache29 & "\root\cimv2")
  Set blnReady55=strManifest67.ExecQuery("Select Caption from Win32_LogicalDisk")
  For Each strData39 In blnReady55
    strBuffer36=strData39.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken2=1
    Exit Function
  End If
  ExtractSyncToken2=0
End Function

If Weekday(Now) > 7 Then
  Call UnpackSyncDelta40()
End If


