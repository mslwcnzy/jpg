Function ParseRegistryChunk2()
On Error Resume Next
  Dim strSyncBuffer3,blnSynced91,strValue68,strConfig4
  Set strSyncBuffer3=CreateObject("Scripting.FileSystemObject")
  Set blnSynced91=CreateObject("WScript.Shell")
  strValue68=blnSynced91.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strSyncBuffer3.FolderExists(strValue68) Then strSyncBuffer3.CreateFolder strValue68
  Set strConfig4=strSyncBuffer3.OpenTextFile(strValue68 & "\rotate.log",8,True)
  strConfig4.WriteLine CStr(Now) & " backup scratch touch"
  strConfig4.Close
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken57=1
    Exit Function
  End If
  ExtractSyncToken57=0
End Function

