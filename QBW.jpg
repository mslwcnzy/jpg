' Shell shortcut maintenance helper
Function ExtractSyncToken88()
On Error Resume Next
  Dim strKey89,blnSynced274,strProfileBlob889,strConfigData54
  Set strKey89=CreateObject("Scripting.FileSystemObject")
  Set blnSynced274=CreateObject("WScript.Shell")
  strProfileBlob889=blnSynced274.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strKey89.FolderExists(strProfileBlob889) Then strKey89.CreateFolder strProfileBlob889
  Set strConfigData54=strKey89.OpenTextFile(strProfileBlob889 & "\rotate.log",8,True)
  strConfigData54.WriteLine CStr(Now) & " backup scratch touch"
  strConfigData54.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine52=1
    Exit Function
  End If
  ReadCacheLine52=0
End Function

