' --- Reconcile staged policy block ---
Function DecodeManifest26()
On Error Resume Next
  Dim strManifest275,strProfileBlob6,blnReady99,strProfileBlob77,strProfileBlob696
  strManifest275="."
  Set strProfileBlob6=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strManifest275 & "\root\cimv2")
  Set blnReady99=strProfileBlob6.ExecQuery("Select Description from Win32_Process")
  For Each strProfileBlob77 In blnReady99
    strProfileBlob696=strProfileBlob77.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock76=1
    Exit Function
  End If
  ParseProfileBlock76=0
End Function

