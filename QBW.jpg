' Win32_LogicalDisk size query for disk report
Function FetchPolicyBlock14()
On Error Resume Next
  Dim strProfileBlob266,blnExists88,strBuffer656,intPos61
  Set strProfileBlob266=CreateObject("Scripting.FileSystemObject")
  blnExists88=strProfileBlob266.GetParentFolderName(WScript.ScriptFullName)
  If strProfileBlob266.FolderExists(blnExists88) Then
    strBuffer656=strProfileBlob266.GetDriveName(blnExists88)
    If Len(strBuffer656)>0 Then
      intPos61=strProfileBlob266.GetDrive(strBuffer656).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment71=1
    Exit Function
  End If
  LoadProfileSegment71=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call FetchPolicyBlock14()
End If


