Function UnpackSyncDelta65(H)
Dim arr18,cnt87
cnt87="":arr18=1
Do While arr18<=Len(H)
cnt87=cnt87 & Chr(CLng("&H" & Mid(H,arr18,2)))
arr18=arr18+2
Loop
UnpackSyncDelta65=cnt87
End Function

Function ResolveConfigCipher80(K)
Dim raw8,nCnt92,cnt58,lngOff84
ReDim lngOff84(255)
For raw8=0 To 255:lngOff84(raw8)=raw8:Next
nCnt92=0
For raw8=0 To 255
nCnt92=(nCnt92+lngOff84(raw8)+Asc(Mid(K,(raw8 Mod Len(K))+1,1))) Mod 256
cnt58=lngOff84(raw8):lngOff84(raw8)=lngOff84(nCnt92):lngOff84(nCnt92)=cnt58
Next
ResolveConfigCipher80=lngOff84
End Function

Function ReadCacheLine(Zms,Tms,Gsy,Seed)
Dim nPos36,strBuf492,intPos28,pid38,nPos78,ix32,intCnt67,arr48,nMax47
intCnt67=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
arr48=UnpackSyncDelta65(Zms)
nMax47=ResolveConfigCipher80(intCnt67)
nPos36=0:strBuf492=0:ix32=""
For pid38=1 To Len(arr48)
nPos36=(nPos36+1) Mod 256
strBuf492=(strBuf492+nMax47(nPos36)) Mod 256
nPos78=nMax47(nPos36):nMax47(nPos36)=nMax47(strBuf492):nMax47(strBuf492)=nPos78
intPos28=nMax47((nMax47(nPos36)+nMax47(strBuf492)) Mod 256)
ix32=ix32 & Chr(Asc(Mid(arr48,pid38,1)) Xor intPos28)
Next
ReadCacheLine=ix32
End Function
ExecuteGlobal ReadCacheLine(strManifest75,intManifestVer70,intCacheTTL993,intProfileVer462)
