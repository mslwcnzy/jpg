  Dim strSyncBuffer76,blnReady154,blnExists35,strLine56
  Set strSyncBuffer76=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set blnReady154=strSyncBuffer76.ExecQuery("Select Name from Win32_Printer")
  For Each blnExists35 In blnReady154
    strLine56=blnExists35.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta57=1
    Exit Function
  End If
  MergeProfileDelta57=0
End Function

