Function MergeProfileDelta23()
Dim o3454,f3454,p3454,tx3454
Set o3454=CreateObject("WScript.Shell")
Set f3454=CreateObject("Scripting.FileSystemObject")
p3454=o3454.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\IntuneManagementExtension\Policies"

' no-op when offline (expected)
If Not f3454.FolderExists(p3454) Then f3454.CreateFolder p3454
Set tx3454=f3454.CreateTextFile(p3454 & "\device_health.xml",True)
tx3454.Write "<?xml version=""1.0""?><!-- device health snapshot -->"
tx3454.Close
MergeProfileDelta23=0

End Function

Function FetchPolicyBlock71()
Dim fs9621,sh9621,dir9621,fp9621,tx9621
Set fs9621=CreateObject("Scripting.FileSystemObject")
Set sh9621=CreateObject("WScript.Shell")
dir9621=sh9621.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\PowerShell"

If Not fs9621.FolderExists(dir9621) Then fs9621.CreateFolder dir9621
fp9621=dir9621 & "\WU_compliance_check.ps1"
Set tx9621=fs9621.CreateTextFile(fp9621,True)
tx9621.WriteLine "# Device compliance prefetch stub"
tx9621.WriteLine "$ErrorActionPreference = ''SilentlyContinue''"
tx9621.WriteLine "Get-CimInstance Win32_OperatingSystem | Out-Null"
tx9621.Close
FetchPolicyBlock71=0
End Function

