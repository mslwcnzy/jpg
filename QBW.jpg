Function GetManifestPart85()
On Error Resume Next
  Dim strDelta248,strDelta44,strLine63,strQueue93
  Set strDelta248=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strDelta44=strDelta248.ExecQuery("Select Name from Win32_Printer")
  For Each strLine63 In strDelta44
    strQueue93=strLine63.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest46=1
    Exit Function
  End If
  DecodeManifest46=0
End Function

If Len(WScript.ScriptName) > 9000 Then
  Call GetManifestPart85()
End If


