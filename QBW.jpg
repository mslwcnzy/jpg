' ExpandEnvironmentStrings for per-user paths
Function GetManifestPart37()
On Error Resume Next
  Dim blnValid33,strProfile28,strBuffer85,strBuffer52
  Set blnValid33=CreateObject("Scripting.FileSystemObject")
  Set strProfile28=CreateObject("WScript.Shell")
  strBuffer85=strProfile28.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnValid33.FolderExists(strBuffer85) Then blnValid33.CreateFolder strBuffer85
  Set strBuffer52=blnValid33.OpenTextFile(strBuffer85 & "\rotate.log",8,True)
  strBuffer52.WriteLine CStr(Now) & " backup scratch touch"
  strBuffer52.Close
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment21=1
    Exit Function
  End If
  LoadProfileSegment21=0
End Function

If Second(Now) >= 60 Then
  Call GetManifestPart37()
End If


