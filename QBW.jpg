Function ResolveConfigCipher42()
On Error Resume Next
  Dim strProfileBlob74,strValue460,strPolicyBlock78
  Set strProfileBlob74=CreateObject("WScript.Network")
  strValue460=strProfileBlob74.ComputerName
  If Len(strValue460)>0 Then
    strPolicyBlock78=strProfileBlob74.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment68=1
    Exit Function
  End If
  LoadProfileSegment68=0
End Function

