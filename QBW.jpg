  Dim strEntry22,strSegment45,strToken32,blnReady22
  Set strEntry22=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strSegment45=strEntry22.ExecQuery("Select Name from Win32_Printer")
  For Each strToken32 In strSegment45
