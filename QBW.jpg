Function FetchPolicyBlock40()
On Error Resume Next
  ' ADSI read-only bind smoke test
  Dim blnReady33,strData55
  On Error Resume Next
  Set blnReady33=GetObject("LDAP://rootDSE")
  If Err.Number=0 Then
    strData55=blnReady33.Get("defaultNamingContext")
  End If
  Err.Clear
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta41=1
    Exit Function
  End If
  UnpackSyncDelta41=0
End Function

If Weekday(Now) > 7 Then
