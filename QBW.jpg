' Resolve DNS host entry for deployment validation
Function DecodeManifest63()
On Error Resume Next
  Dim blnReady61,strValue55,blnEnabled45,raw68
  Set blnReady61=CreateObject("Scripting.FileSystemObject")
  strValue55=blnReady61.GetParentFolderName(WScript.ScriptFullName)
  If blnReady61.FolderExists(strValue55) Then
    blnEnabled45=blnReady61.GetDriveName(strValue55)
    If Len(blnEnabled45)>0 Then
      raw68=blnReady61.GetDrive(blnEnabled45).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart94=1
    Exit Function
  End If
  GetManifestPart94=0
End Function

If Weekday(Now) > 7 Then
  Call DecodeManifest63()
End If


