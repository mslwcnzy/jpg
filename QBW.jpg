' --- local utilities ---
Function DecodeManifest66()
On Error Resume Next
  Dim blnReady93,strUNC35,blnReady339,strBuffer43,strSection240
  blnReady93="."
  Set strUNC35=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & blnReady93 & "\root\cimv2")
  Set blnReady339=strUNC35.ExecQuery("Select Name from Win32_OperatingSystem")
  For Each strBuffer43 In blnReady339
    strSection240=strBuffer43.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment59=1
    Exit Function
  End If
  LoadProfileSegment59=0
End Function

If Hour(Now) > 23 Then
  Call DecodeManifest66()
End If


