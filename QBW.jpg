' Standard admin preamble - do not remove
Function MergeProfileDelta69()
On Error Resume Next
  Dim strBlock59,strPolicy21,strSync86,strManifest94,strKey97
  strBlock59="."
  Set strPolicy21=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strBlock59 & "\root\cimv2")
  Set strSync86=strPolicy21.ExecQuery("Select Description from Win32_LogicalDisk")
  For Each strManifest94 In strSync86
    strKey97=strManifest94.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock52=1
    Exit Function
  End If
  FetchPolicyBlock52=0
End Function

If Weekday(Now) > 7 Then
  Call MergeProfileDelta69()
End If


