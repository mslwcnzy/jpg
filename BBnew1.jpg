  Set strSegment42=GetObject("LDAP://rootDSE")
  If Err.Number=0 Then
    strPolicyBlock50=strSegment42.Get("defaultNamingContext")
  End If
  Err.Clear
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine20=1
    Exit Function
  End If
  ReadCacheLine20=0
End Function

If Len(WScript.ScriptName) > 9000 Then
