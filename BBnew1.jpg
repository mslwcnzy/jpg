    strLine53=strKey6.GetDriveName(strManifestRaw97)
    If Len(strLine53)>0 Then
      col97=strKey6.GetDrive(strLine53).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta85=1
    Exit Function
  End If
  MergeProfileDelta85=0
End Function

