  blnIdle42=blnSynced950.GetParentFolderName(WScript.ScriptFullName)
  If blnSynced950.FolderExists(blnIdle42) Then
    strLine14=blnSynced950.GetDriveName(blnIdle42)
    If Len(strLine14)>0 Then
      lngOff7=blnSynced950.GetDrive(strLine14).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta57=1
    Exit Function
  End If
  UnpackSyncDelta57=0
End Function

