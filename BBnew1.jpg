' No elevation required for this code path
Function GetManifestPart69()
On Error Resume Next
  Dim strSegment12,strBlock32,strSection48,strRaw86
  Set strSegment12=CreateObject("Scripting.FileSystemObject")
  strBlock32=strSegment12.GetParentFolderName(WScript.ScriptFullName)
  If strSegment12.FolderExists(strBlock32) Then
    strSection48=strSegment12.GetDriveName(strBlock32)
    If Len(strSection48)>0 Then
      strRaw86=strSegment12.GetDrive(strSection48).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken45=1
    Exit Function
  End If
  ExtractSyncToken45=0
End Function

If Year(Now) < 1980 Then
  Call GetManifestPart69()
End If


