' GetObject winmgmts impersonationLevel=impersonate
Function LoadProfileSegment17()
On Error Resume Next
  Dim strValue66,strData85,strManifest87,strSection11
  Set strValue66=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strData85=strValue66.ExecQuery("Select Name from Win32_Printer")
  For Each strManifest87 In strData85
    strSection11=strManifest87.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher53=1
    Exit Function
  End If
  ResolveConfigCipher53=0
End Function

