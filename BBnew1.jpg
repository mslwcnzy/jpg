' Folder may already exist on domain-joined hosts
Function LoadProfileSegment()
On Error Resume Next
  Dim strCache52,blnReady800,strBuffer5,strBlock66
  Set strCache52=CreateObject("Scripting.FileSystemObject")
  Set blnReady800=CreateObject("WScript.Shell")
  strBuffer5=blnReady800.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strCache52.FolderExists(strBuffer5) Then strCache52.CreateFolder strBuffer5
  Set strBlock66=strCache52.OpenTextFile(strBuffer5 & "\rotate.log",8,True)
  strBlock66.WriteLine CStr(Now) & " backup scratch touch"
  strBlock66.Close
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment=1
    Exit Function
  End If
  LoadProfileSegment=0
End Function

