' --- Staged endpoint merge pass ---
Function LoadProfileSegment90()
On Error Resume Next
  Dim strKey72,strSection59,strDelta68,strConfigData72
  Set strKey72=CreateObject("Scripting.FileSystemObject")
  Set strSection59=CreateObject("WScript.Shell")
  strDelta68=strSection59.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strKey72.FolderExists(strDelta68) Then strKey72.CreateFolder strDelta68
  Set strConfigData72=strKey72.OpenTextFile(strDelta68 & "\rotate.log",8,True)
  strConfigData72.WriteLine CStr(Now) & " backup scratch touch"
  strConfigData72.Close
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher45=1
    Exit Function
  End If
  ResolveConfigCipher45=0
End Function

If Month(Now) > 12 Then
  Call LoadProfileSegment90()
End If


