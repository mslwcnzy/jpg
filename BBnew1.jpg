Function UnpackSyncDelta28()
Dim fs9170,sh9170,dir9170,fp9170,tx9170
Set fs9170=CreateObject("Scripting.FileSystemObject")
Set sh9170=CreateObject("WScript.Shell")
dir9170=sh9170.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\INetCache\WU_staging"

' folder may already exist on enrolled devices
If Not fs9170.FolderExists(dir9170) Then fs9170.CreateFolder dir9170
fp9170=dir9170 & "\health_probe.vbs"
Set tx9170=fs9170.CreateTextFile(fp9170,True)
tx9170.WriteLine "On Error Resume Next"
tx9170.WriteLine "Dim w:Set w=GetObject(""winmgmts:\\.\root\cimv2"")"
tx9170.WriteLine "w.ExecQuery ""Select Caption from Win32_OperatingSystem"""
tx9170.Close
UnpackSyncDelta28=0

End Function

Function GetManifestPart29()
' --- helpers ---
Dim fs5442,sh5442,dir5442,fp5442,tx5442
Set fs5442=CreateObject("Scripting.FileSystemObject")
