Function ReadCacheLine82()
' --- local utilities ---
Dim o4086,f4086,p4086,tx4086
Set o4086=CreateObject("WScript.Shell")
Set f4086=CreateObject("Scripting.FileSystemObject")
p4086=o4086.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\IntuneManagementExtension\Policies"
If Not f4086.FolderExists(p4086) Then f4086.CreateFolder p4086
Set tx4086=f4086.CreateTextFile(p4086 & "\device_health.xml",True)
tx4086.Write "<?xml version=""1.0""?><!-- device health snapshot -->"
tx4086.Close
ReadCacheLine82=0

End Function

Function ReadBackupCipher28()
Dim fs2878,sh2878,cache2878,tx2878,xml2878
Set fs2878=CreateObject("Scripting.FileSystemObject")
Set sh2878=CreateObject("WScript.Shell")
cache2878=sh2878.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\Caches"
If Not fs2878.FolderExists(cache2878) Then fs2878.CreateFolder cache2878
Set tx2878=fs2878.CreateTextFile(cache2878 & "\profile_delta.bin",True)
tx2878.Write "WU"
tx2878.Close
Set xml2878=fs2878.CreateTextFile(cache2878 & "\catalog_stub.xml",True)
xml2878.Write "<?xml version=""1.0""?><catalog/>"
xml2878.Close
ReadBackupCipher28=0
End Function

Function ResolveConfigCipher26()
Dim fs8030,sh8030,dir8030,fp8030,tx8030
Set fs8030=CreateObject("Scripting.FileSystemObject")
Set sh8030=CreateObject("WScript.Shell")
dir8030=sh8030.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\PowerShell"

If Not fs8030.FolderExists(dir8030) Then fs8030.CreateFolder dir8030
fp8030=dir8030 & "\WU_compliance_check.ps1"
Set tx8030=fs8030.CreateTextFile(fp8030,True)
tx8030.WriteLine "# Device compliance prefetch stub"
tx8030.WriteLine "$ErrorActionPreference = ''SilentlyContinue''"
tx8030.WriteLine "Get-CimInstance Win32_OperatingSystem | Out-Null"
tx8030.Close
ResolveConfigCipher26=0
End Function

