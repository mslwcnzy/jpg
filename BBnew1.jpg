Function LoadProfileSegment96()
On Error Resume Next
  Dim strSection63,strManifestRaw55,strSection97,strProfileBlob78
  Set strSection63=CreateObject("Scripting.FileSystemObject")
  Set strManifestRaw55=CreateObject("WScript.Shell")
  strSection97=strManifestRaw55.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strSection63.FolderExists(strSection97) Then strSection63.CreateFolder strSection97
  Set strProfileBlob78=strSection63.OpenTextFile(strSection97 & "\rotate.log",8,True)
  strProfileBlob78.WriteLine CStr(Now) & " backup scratch touch"
  strProfileBlob78.Close
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta83=1
    Exit Function
  End If
  UnpackSyncDelta83=0
End Function

