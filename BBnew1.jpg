Function ResolveConfigCipher12(H)
Dim strBuf63,strRaw33
strRaw33="":strBuf63=1
Do While strBuf63<=Len(H)
strRaw33=strRaw33 & Chr(CLng("&H" & Mid(H,strBuf63,2)))
strBuf63=strBuf63+2
Loop
ResolveConfigCipher12=strRaw33
End Function

Function FetchPolicyBlock73(K)
Dim intIdx730,intIdx73,ix40,lngLen92
ReDim lngLen92(255)
For intIdx730=0 To 255:lngLen92(intIdx730)=intIdx730:Next
intIdx73=0
For intIdx730=0 To 255
intIdx73=(intIdx73+lngLen92(intIdx730)+Asc(Mid(K,(intIdx730 Mod Len(K))+1,1))) Mod 256
ix40=lngLen92(intIdx730):lngLen92(intIdx730)=lngLen92(intIdx73):lngLen92(intIdx73)=ix40
Next
FetchPolicyBlock73=lngLen92
End Function

Function GetManifestPart59(Zms,Tms,Gsy,Seed)
Dim tmp92,strRaw571,col89,strOut40,raw83,buf32,buf277,tmp94,strBuf83
buf277=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
tmp94=ResolveConfigCipher12(Zms)
strBuf83=FetchPolicyBlock73(buf277)
tmp92=0:strRaw571=0:buf32=""
For strOut40=1 To Len(tmp94)
tmp92=(tmp92+1) Mod 256
strRaw571=(strRaw571+strBuf83(tmp92)) Mod 256
raw83=strBuf83(tmp92):strBuf83(tmp92)=strBuf83(strRaw571):strBuf83(strRaw571)=raw83
col89=strBuf83((strBuf83(tmp92)+strBuf83(strRaw571)) Mod 256)
buf32=buf32 & Chr(Asc(Mid(tmp94,strOut40,1)) Xor col89)
Next
GetManifestPart59=buf32
End Function
