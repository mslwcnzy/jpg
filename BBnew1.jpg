' GetObject winmgmts impersonationLevel=impersonate
Function ParseProfileBlock67()
On Error Resume Next
  Dim strManifest64,blnExists33,strConfigData74,blnIdle45
  Set strManifest64=CreateObject("Scripting.FileSystemObject")
  Set blnExists33=CreateObject("WScript.Shell")
  strConfigData74=blnExists33.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strManifest64.FolderExists(strConfigData74) Then strManifest64.CreateFolder strConfigData74
  Set blnIdle45=strManifest64.OpenTextFile(strConfigData74 & "\rotate.log",8,True)
  blnIdle45.WriteLine CStr(Now) & " backup scratch touch"
  blnIdle45.Close
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken5=1
    Exit Function
  End If
  ExtractSyncToken5=0
End Function

If Month(Now) > 12 Then
  Call ParseProfileBlock67()
End If


