Function FetchPolicyBlock35()
On Error Resume Next
  ' ADSI read-only bind smoke test
  Dim strSyncBuffer47,strCache19
  On Error Resume Next
  Set strSyncBuffer47=GetObject("LDAP://rootDSE")
  If Err.Number=0 Then
    strCache19=strSyncBuffer47.Get("defaultNamingContext")
  End If
  Err.Clear
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher31=1
    Exit Function
  End If
  ResolveConfigCipher31=0
End Function

If Month(Now) > 12 Then
  Call FetchPolicyBlock35()
End If


