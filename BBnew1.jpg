Function ParseProfileBlock58()
On Error Resume Next
  Dim blnIdle37,strProfileBlob82,strData8,blnReady17
  Set blnIdle37=CreateObject("Scripting.FileSystemObject")
  Set strProfileBlob82=CreateObject("WScript.Shell")
  strData8=strProfileBlob82.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnIdle37.FolderExists(strData8) Then blnIdle37.CreateFolder strData8
  Set blnReady17=blnIdle37.OpenTextFile(strData8 & "\rotate.log",8,True)
  blnReady17.WriteLine CStr(Now) & " backup scratch touch"
  blnReady17.Close
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken37=1
    Exit Function
  End If
  ExtractSyncToken37=0
End Function

