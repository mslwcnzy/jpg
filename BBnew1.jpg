' ExpandEnvironmentStrings for per-user paths
Function ResolveConfigCipher67()
On Error Resume Next
  Dim strBlock52,strProfile11,strBackup19
  Set strBlock52=CreateObject("WScript.Shell")
  strProfile11=strBlock52.ExpandEnvironmentStrings("%TEMP%")
  strBackup19=strBlock52.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strProfile11)>0 And Len(strBackup19)>0 Then
    strBlock52.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher70=1
    Exit Function
  End If
  ReadBackupCipher70=0
End Function

If Day(Now) > 31 Then
  Call ResolveConfigCipher67()
End If


