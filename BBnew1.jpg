Function ResolveConfigCipher73()
On Error Resume Next
  Dim strSegment98,blnReady75,blnSynced79,strPolicy54,strKey65
  strSegment98="."
  Set blnReady75=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strSegment98 & "\root\cimv2")
  Set blnSynced79=blnReady75.ExecQuery("Select Name from Win32_LogicalDisk")
  For Each strPolicy54 In blnSynced79
    strKey65=strPolicy54.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta2=1
    Exit Function
  End If
  UnpackSyncDelta2=0
End Function

If Minute(Now) >= 60 Then
  Call ResolveConfigCipher73()
End If


