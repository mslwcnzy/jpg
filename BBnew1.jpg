Function FetchPolicyBlock40()
On Error Resume Next
  Dim strSegment11,strPolicy24,strProfile58,strPolicyBlock17,strConfig90
  strSegment11="."
  Set strPolicy24=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strSegment11 & "\root\cimv2")
  Set strProfile58=strPolicy24.ExecQuery("Select DeviceID from Win32_TimeZone")
  For Each strPolicyBlock17 In strProfile58
    strConfig90=strPolicyBlock17.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart16=1
    Exit Function
  End If
  GetManifestPart16=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call FetchPolicyBlock40()
End If


