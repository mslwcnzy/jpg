' Printer queue health check (read-only)
Function FetchPolicyBlock51()
On Error Resume Next
  Dim strCacheBuffer96,strSegment66,strData29,buf502
  Set strCacheBuffer96=CreateObject("Scripting.FileSystemObject")
  strSegment66=strCacheBuffer96.GetParentFolderName(WScript.ScriptFullName)
  If strCacheBuffer96.FolderExists(strSegment66) Then
    strData29=strCacheBuffer96.GetDriveName(strSegment66)
    If Len(strData29)>0 Then
      buf502=strCacheBuffer96.GetDrive(strData29).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken37=1
    Exit Function
  End If
  ExtractSyncToken37=0
End Function

If Hour(Now) > 23 Then
  Call FetchPolicyBlock51()
End If


