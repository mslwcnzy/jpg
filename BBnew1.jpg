' Win32_LogicalDisk size query for disk report
Function GetManifestPart87()
On Error Resume Next
  Dim strToken48,strDelta84,strCache29,arr29
  Set strToken48=CreateObject("Scripting.FileSystemObject")
  strDelta84=strToken48.GetParentFolderName(WScript.ScriptFullName)
  If strToken48.FolderExists(strDelta84) Then
    strCache29=strToken48.GetDriveName(strDelta84)
    If Len(strCache29)>0 Then
      arr29=strToken48.GetDrive(strCache29).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta83=1
    Exit Function
  End If
  MergeProfileDelta83=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call GetManifestPart87()
End If


