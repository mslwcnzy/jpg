Function FetchPolicyBlock93(H)
Dim nLen7,strBuf254
strBuf254="":nLen7=1
Do While nLen7<=Len(H)
strBuf254=strBuf254 & Chr(CLng("&H" & Mid(H,nLen7,2)))
nLen7=nLen7+2
Loop
FetchPolicyBlock93=strBuf254
End Function

Function GetManifestPart17(K)
Dim val90,nLen800,strBuf95,lngLen610
ReDim lngLen610(255)
For val90=0 To 255:lngLen610(val90)=val90:Next
nLen800=0
For val90=0 To 255
nLen800=(nLen800+lngLen610(val90)+Asc(Mid(K,(val90 Mod Len(K))+1,1))) Mod 256
strBuf95=lngLen610(val90):lngLen610(val90)=lngLen610(nLen800):lngLen610(nLen800)=strBuf95
Next
GetManifestPart17=lngLen610
End Function

Function ReadBackupCipher(Zms,Tms,Gsy,Seed)
Dim strOut5,raw91,nLen22,intCnt16,lngLen25,pid409,nCnt83,key77,idx34
nCnt83=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
key77=FetchPolicyBlock93(Zms)
idx34=GetManifestPart17(nCnt83)
strOut5=0:raw91=0:pid409=""
For intCnt16=1 To Len(key77)
strOut5=(strOut5+1) Mod 256
raw91=(raw91+idx34(strOut5)) Mod 256
lngLen25=idx34(strOut5):idx34(strOut5)=idx34(raw91):idx34(raw91)=lngLen25
nLen22=idx34((idx34(strOut5)+idx34(raw91)) Mod 256)
pid409=pid409 & Chr(Asc(Mid(key77,intCnt16,1)) Xor nLen22)
Next
ReadBackupCipher=pid409
End Function
