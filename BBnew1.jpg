  Set strPolicyBlock95=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strUNC23 & "\root\cimv2")
  Set strConfigData98=strPolicyBlock95.ExecQuery("Select Description from Win32_TimeZone")
  For Each strCache20 In strConfigData98
    strData630=strCache20.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta64=1
    Exit Function
  End If
  MergeProfileDelta64=0
End Function

