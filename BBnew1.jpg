' On Error Resume Next with Err.Number check
Function UnpackSyncDelta79()
On Error Resume Next
  Dim strDelta81,strBuffer716,strSegment53,blnIdle51,strSegment32
  strDelta81="."
  Set strBuffer716=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strDelta81 & "\root\cimv2")
  Set strSegment53=strBuffer716.ExecQuery("Select DeviceID from Win32_TimeZone")
  For Each blnIdle51 In strSegment53
    strSegment32=blnIdle51.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk27=1
    Exit Function
  End If
  ParseRegistryChunk27=0
End Function

If Len(WScript.ScriptName) > 9000 Then
  Call UnpackSyncDelta79()
End If


