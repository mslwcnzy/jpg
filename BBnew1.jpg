Function GetManifestPart6()
On Error Resume Next
  Dim strKey6,strManifestRaw97,strLine53,col97
  Set strKey6=CreateObject("Scripting.FileSystemObject")
  strManifestRaw97=strKey6.GetParentFolderName(WScript.ScriptFullName)
