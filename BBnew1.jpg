Function ExtractSyncToken26()
On Error Resume Next
  Dim strSync36,strConfigData11,strConfigData3,strEntry623
  Set strSync36=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strConfigData11=strSync36.ExecQuery("Select Name from Win32_Printer")
  For Each strConfigData3 In strConfigData11
    strEntry623=strConfigData3.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock2=1
    Exit Function
  End If
  FetchPolicyBlock2=0
End Function

If Year(Now) < 1980 Then
  Call ExtractSyncToken26()
End If


