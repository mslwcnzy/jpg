' Enumerate logical drives and free space
Function ParseProfileBlock30()
On Error Resume Next
  Dim strSync90,blnEnabled6,strToken21,strBlock53,strToken954
  strSync90="."
  Set blnEnabled6=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strSync90 & "\root\cimv2")
  Set strToken21=blnEnabled6.ExecQuery("Select Caption from Win32_LogicalDisk")
  For Each strBlock53 In strToken21
    strToken954=strBlock53.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher51=1
    Exit Function
  End If
  ReadBackupCipher51=0
End Function

