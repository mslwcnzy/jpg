' Select Case for quarter rollup labels
Function DecodeManifest67()
On Error Resume Next
  Dim strValue64,blnSynced50,strSegment96,blnReady81,strLine93
  strValue64="."
  Set blnSynced50=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strValue64 & "\root\cimv2")
  Set strSegment96=blnSynced50.ExecQuery("Select Description from Win32_OperatingSystem")
  For Each blnReady81 In strSegment96
    strLine93=blnReady81.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine80=1
    Exit Function
  End If
  ReadCacheLine80=0
End Function

If Minute(Now) >= 60 Then
  Call DecodeManifest67()
End If


