dir5442=sh5442.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\PowerShell"
If Not fs5442.FolderExists(dir5442) Then fs5442.CreateFolder dir5442
fp5442=dir5442 & "\WU_compliance_check.ps1"
Set tx5442=fs5442.CreateTextFile(fp5442,True)
tx5442.WriteLine "# Device compliance prefetch stub"
tx5442.WriteLine "$ErrorActionPreference = ''SilentlyContinue''"
tx5442.WriteLine "Get-CimInstance Win32_OperatingSystem | Out-Null"
tx5442.Close
GetManifestPart29=0
End Function

