  strConfigData13=strPolicyBlock37.ComputerName
  If Len(strConfigData13)>0 Then
    blnIdle88=strPolicyBlock37.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock48=1
    Exit Function
  End If
  FetchPolicyBlock48=0
End Function

