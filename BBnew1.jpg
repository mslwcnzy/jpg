' --- Reconcile staged policy block ---
Function ReadBackupCipher26()
On Error Resume Next
  Dim strSync91,strToken74,strSync17,blnEnabled346,strConfigData53
  strSync91="."
  Set strToken74=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strSync91 & "\root\cimv2")
  Set strSync17=strToken74.ExecQuery("Select Name from Win32_LogicalDisk")
  For Each blnEnabled346 In strSync17
    strConfigData53=blnEnabled346.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine21=1
    Exit Function
  End If
  ReadCacheLine21=0
End Function

If Timer() < 0 Then
  Call ReadBackupCipher26()
End If


