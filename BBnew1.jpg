  Set strPath22=CreateObject("Scripting.FileSystemObject")
  Set blnIdle65=CreateObject("WScript.Shell")
  strToken69=blnIdle65.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strPath22.FolderExists(strToken69) Then strPath22.CreateFolder strToken69
  Set strDelta33=strPath22.OpenTextFile(strToken69 & "\rotate.log",8,True)
  strDelta33.WriteLine CStr(Now) & " backup scratch touch"
