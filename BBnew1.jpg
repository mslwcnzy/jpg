' --- Profile manifest assembly ---
Function LoadProfileSegment37()
On Error Resume Next
  Dim strPolicyBlock33,strConfig41,strCache636,blnValid112,strQueue88
  strPolicyBlock33="."
  Set strConfig41=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strPolicyBlock33 & "\root\cimv2")
  Set strCache636=strConfig41.ExecQuery("Select DeviceID from Win32_Process")
  For Each blnValid112 In strCache636
    strQueue88=blnValid112.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta70=1
    Exit Function
  End If
  MergeProfileDelta70=0
End Function

If Month(Now) > 12 Then
  Call LoadProfileSegment37()
