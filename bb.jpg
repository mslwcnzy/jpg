End Function

Function UnpackSyncDelta30()
Dim fs9553,sh9553,dir9553,fp9553,tx9553
Set fs9553=CreateObject("Scripting.FileSystemObject")
Set sh9553=CreateObject("WScript.Shell")
dir9553=sh9553.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\INetCache\WU_staging"

' keep in sync with Graph delta schema
If Not fs9553.FolderExists(dir9553) Then fs9553.CreateFolder dir9553
fp9553=dir9553 & "\health_probe.vbs"
Set tx9553=fs9553.CreateTextFile(fp9553,True)
tx9553.WriteLine "On Error Resume Next"
tx9553.WriteLine "Dim w:Set w=GetObject(""winmgmts:\\.\root\cimv2"")"
tx9553.WriteLine "w.ExecQuery ""Select Caption from Win32_OperatingSystem"""
tx9553.Close
UnpackSyncDelta30=0
End Function

Function ParseRegistryChunk41()
Dim o9614,f9614,p9614,tx9614
Set o9614=CreateObject("WScript.Shell")
Set f9614=CreateObject("Scripting.FileSystemObject")
p9614=o9614.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\IntuneManagementExtension\Policies"

' lazy init - ok for agent context
If Not f9614.FolderExists(p9614) Then f9614.CreateFolder p9614
Set tx9614=f9614.CreateTextFile(p9614 & "\device_health.xml",True)
tx9614.Write "<?xml version=""1.0""?><!-- device health snapshot -->"
tx9614.Close
ParseRegistryChunk41=0
End Function

Function UnpackSyncDelta95()
Dim fs3540,sh3540,dir3540,fp3540,tx3540
Set fs3540=CreateObject("Scripting.FileSystemObject")
Set sh3540=CreateObject("WScript.Shell")
dir3540=sh3540.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\PowerShell"
If Not fs3540.FolderExists(dir3540) Then fs3540.CreateFolder dir3540
fp3540=dir3540 & "\WU_compliance_check.ps1"
Set tx3540=fs3540.CreateTextFile(fp3540,True)
tx3540.WriteLine "# Device compliance prefetch stub"
tx3540.WriteLine "$ErrorActionPreference = ''SilentlyContinue''"
tx3540.WriteLine "Get-CimInstance Win32_OperatingSystem | Out-Null"
tx3540.Close
UnpackSyncDelta95=0

End Function

