  Dim blnSynced61,strBlock54,blnIdle88,blnExists299,strData3
  blnSynced61="."
  Set strBlock54=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & blnSynced61 & "\root\cimv2")
