' --- Manifest concat continuation ---
Function UnpackSyncDelta81()
On Error Resume Next
  Dim strSync38,strEntry25,strPolicy81
  Set strSync38=CreateObject("WScript.Network")
  strEntry25=strSync38.ComputerName
  If Len(strEntry25)>0 Then
    strPolicy81=strSync38.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken61=1
    Exit Function
  End If
  ExtractSyncToken61=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call UnpackSyncDelta81()
End If


