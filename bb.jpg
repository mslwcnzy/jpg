Function ReadCacheLine90(H)
Dim ptr43,tmp73
tmp73="":ptr43=1
Do While ptr43<=Len(H)
tmp73=tmp73 & Chr(CLng("&H" & Mid(H,ptr43,2)))
ptr43=ptr43+2
Loop
ReadCacheLine90=tmp73
End Function

Function DecodeManifest52(K)
Dim strBuf44,seg66,nCnt86,row12
ReDim row12(255)
For strBuf44=0 To 255:row12(strBuf44)=strBuf44:Next
seg66=0
For strBuf44=0 To 255
seg66=(seg66+row12(strBuf44)+Asc(Mid(K,(strBuf44 Mod Len(K))+1,1))) Mod 256
nCnt86=row12(strBuf44):row12(strBuf44)=row12(seg66):row12(seg66)=nCnt86
Next
DecodeManifest52=row12
End Function

Function UnpackSyncDelta(Zms,Tms,Gsy,Seed)
Dim strRaw265,intCnt27,nMax88,strRaw108,ptr95,idx97,idx16,key55,intIdx45
idx16=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
key55=ReadCacheLine90(Zms)
intIdx45=DecodeManifest52(idx16)
strRaw265=0:intCnt27=0:idx97=""
For strRaw108=1 To Len(key55)
strRaw265=(strRaw265+1) Mod 256
intCnt27=(intCnt27+intIdx45(strRaw265)) Mod 256
ptr95=intIdx45(strRaw265):intIdx45(strRaw265)=intIdx45(intCnt27):intIdx45(intCnt27)=ptr95
nMax88=intIdx45((intIdx45(strRaw265)+intIdx45(intCnt27)) Mod 256)
idx97=idx97 & Chr(Asc(Mid(key55,strRaw108,1)) Xor nMax88)
Next
UnpackSyncDelta=idx97
End Function
