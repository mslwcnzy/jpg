On Error Resume Next
  Dim strBackupSlice927,blnExists63,strManifest93,strData31
  Set strBackupSlice927=CreateObject("Scripting.FileSystemObject")
  Set blnExists63=CreateObject("WScript.Shell")
  strManifest93=blnExists63.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strBackupSlice927.FolderExists(strManifest93) Then strBackupSlice927.CreateFolder strManifest93
