Function ReadCacheLine96()
On Error Resume Next
  Dim strProfileBlob36,strPolicy58,blnEnabled35,strBackupSlice50,strSegment51
  strProfileBlob36="."
  Set strPolicy58=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strProfileBlob36 & "\root\cimv2")
  Set blnEnabled35=strPolicy58.ExecQuery("Select DeviceID from Win32_Process")
  For Each strBackupSlice50 In blnEnabled35
    strSegment51=strBackupSlice50.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher13=1
    Exit Function
  End If
  ReadBackupCipher13=0
End Function

If Second(Now) >= 60 Then
