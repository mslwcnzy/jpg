Function GetManifestPart71()
On Error Resume Next
  Dim strKey65,strSyncBuffer13,blnReady94,strLine97
  Set strKey65=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strSyncBuffer13=strKey65.ExecQuery("Select Name from Win32_Printer")
  For Each blnReady94 In strSyncBuffer13
    strLine97=blnReady94.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine14=1
