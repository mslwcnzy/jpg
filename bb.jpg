Function ReadBackupCipher99()
On Error Resume Next
  Dim strUNC43,strLine473,strUNC30,blnValid97
  Set strUNC43=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strLine473=strUNC43.ExecQuery("Select Name from Win32_Printer")
  For Each strUNC30 In strLine473
    blnValid97=strUNC30.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock93=1
    Exit Function
  End If
  FetchPolicyBlock93=0
End Function

