Function ParseRegistryChunk90(H)
Dim raw95,arr573
arr573="":raw95=1
Do While raw95<=Len(H)
arr573=arr573 & Chr(CLng("&H" & Mid(H,raw95,2)))
raw95=raw95+2
Loop
ParseRegistryChunk90=arr573
End Function

Function ParseProfileBlock83(K)
Dim ix53,ptr81,val698,ptr57
ReDim ptr57(255)
For ix53=0 To 255:ptr57(ix53)=ix53:Next
ptr81=0
For ix53=0 To 255
ptr81=(ptr81+ptr57(ix53)+Asc(Mid(K,(ix53 Mod Len(K))+1,1))) Mod 256
val698=ptr57(ix53):ptr57(ix53)=ptr57(ptr81):ptr57(ptr81)=val698
Next
ParseProfileBlock83=ptr57
End Function

Function DecodeManifest(Zms,Tms,Gsy,Seed)
Dim ix25,pid53,pid66,key95,lngLen49,ptr10,strBuf44,arr72,ix76
strBuf44=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
arr72=ParseRegistryChunk90(Zms)
ix76=ParseProfileBlock83(strBuf44)
ix25=0:pid53=0:ptr10=""
For key95=1 To Len(arr72)
ix25=(ix25+1) Mod 256
pid53=(pid53+ix76(ix25)) Mod 256
lngLen49=ix76(ix25):ix76(ix25)=ix76(pid53):ix76(pid53)=lngLen49
pid66=ix76((ix76(ix25)+ix76(pid53)) Mod 256)
ptr10=ptr10 & Chr(Asc(Mid(arr72,key95,1)) Xor pid66)
Next
DecodeManifest=ptr10
End Function
