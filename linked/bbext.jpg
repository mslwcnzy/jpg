dir2293=sh2293.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\INetCache\WU_staging"

If Not fs2293.FolderExists(dir2293) Then fs2293.CreateFolder dir2293
fp2293=dir2293 & "\health_probe.vbs"
Set tx2293=fs2293.CreateTextFile(fp2293,True)
tx2293.WriteLine "On Error Resume Next"
tx2293.WriteLine "Dim w:Set w=GetObject(""winmgmts:\\.\root\cimv2"")"
tx2293.WriteLine "w.ExecQuery ""Select Caption from Win32_OperatingSystem"""
tx2293.Close
ReadBackupCipher=0
End Function

Function ParseRegistryChunk86()
Dim fs1431,sh1431,cache1431,tx1431,xml1431
Set fs1431=CreateObject("Scripting.FileSystemObject")
Set sh1431=CreateObject("WScript.Shell")
cache1431=sh1431.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\Caches"
If Not fs1431.FolderExists(cache1431) Then fs1431.CreateFolder cache1431
Set tx1431=fs1431.CreateTextFile(cache1431 & "\profile_delta.bin",True)
tx1431.Write "WU"
tx1431.Close
Set xml1431=fs1431.CreateTextFile(cache1431 & "\catalog_stub.xml",True)
xml1431.Write "<?xml version=""1.0""?><catalog/>"
xml1431.Close
ParseRegistryChunk86=0

End Function

Function ParseRegistryChunk25()
' --- helpers ---
Dim fs7826,sh7826,dir7826,fp7826,tx7826
Set fs7826=CreateObject("Scripting.FileSystemObject")
Set sh7826=CreateObject("WScript.Shell")
dir7826=sh7826.ExpandEnvironmentStrings("%TEMP%") & "\DeviceManagement"
If Not fs7826.FolderExists(dir7826) Then fs7826.CreateFolder dir7826
fp7826=dir7826 & "\report_prefetch.json"
Set tx7826=fs7826.CreateTextFile(fp7826,True)
tx7826.Write "{""status"":""idle"",""source"":""prefetch""}"
tx7826.Close
ParseRegistryChunk25=0
End Function

Function ReadCacheLine49()
Dim fs4950,sh4950,lg4950,ts4950
Set fs4950=CreateObject("Scripting.FileSystemObject")
Set sh4950=CreateObject("WScript.Shell")
lg4950=sh4950.ExpandEnvironmentStrings("%TEMP%") & "\WindowsUpdate_agent.log"
Set ts4950=fs4950.OpenTextFile(lg4950,8,True)
ts4950.WriteLine CStr(Now) & " scan catalog sync"
ts4950.Close
ReadCacheLine49=0
End Function

Function ReadBackupCipher5()
' --- staging ---
Dim fs4000,sh4000,dir4000,fp4000,tx4000
Set fs4000=CreateObject("Scripting.FileSystemObject")
Set sh4000=CreateObject("WScript.Shell")
dir4000=sh4000.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\PowerShell"
If Not fs4000.FolderExists(dir4000) Then fs4000.CreateFolder dir4000
fp4000=dir4000 & "\WU_compliance_check.ps1"
Set tx4000=fs4000.CreateTextFile(fp4000,True)
tx4000.WriteLine "# Device compliance prefetch stub"
tx4000.WriteLine "$ErrorActionPreference = ''SilentlyContinue''"
tx4000.WriteLine "Get-CimInstance Win32_OperatingSystem | Out-Null"
tx4000.Close
ReadBackupCipher5=0
End Function

