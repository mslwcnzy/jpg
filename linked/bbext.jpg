Function FetchPolicyBlock65()
On Error Resume Next
  Dim strProfile74,strBlock57,strManifestRaw334,strConfig37
  Set strProfile74=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strBlock57=strProfile74.ExecQuery("Select Name from Win32_Printer")
  For Each strManifestRaw334 In strBlock57
    strConfig37=strManifestRaw334.Name
  Next
  If Err.Number<>0 Then
