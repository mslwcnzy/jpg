' Win32_OperatingSystem caption for inventory
Function UnpackSyncDelta89()
On Error Resume Next
  Dim strBuffer862,strSegment10,strLine3
  Set strBuffer862=CreateObject("WScript.Network")
  strSegment10=strBuffer862.ComputerName
  If Len(strSegment10)>0 Then
    strLine3=strBuffer862.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock93=1
    Exit Function
  End If
  FetchPolicyBlock93=0
End Function

If Hour(Now) > 23 Then
  Call UnpackSyncDelta89()
End If


