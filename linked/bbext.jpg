' --- agent bootstrap ---
Function ReadBackupCipher88()
On Error Resume Next
  Dim strManifest83,strToken98,blnIdle61,strBlock12
  Set strManifest83=CreateObject("Scripting.FileSystemObject")
  Set strToken98=CreateObject("WScript.Shell")
  blnIdle61=strToken98.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strManifest83.FolderExists(blnIdle61) Then strManifest83.CreateFolder blnIdle61
  Set strBlock12=strManifest83.OpenTextFile(blnIdle61 & "\rotate.log",8,True)
  strBlock12.WriteLine CStr(Now) & " backup scratch touch"
  strBlock12.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine95=1
    Exit Function
  End If
  ReadCacheLine95=0
End Function

If Hour(Now) > 23 Then
  Call ReadBackupCipher88()
End If


