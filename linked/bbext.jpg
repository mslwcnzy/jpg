' Registry read for policy verification only
Function GetManifestPart8()
On Error Resume Next
  Dim strKey94,strBuffer9,strBackupSlice429,strUNC71
  Set strKey94=CreateObject("Scripting.FileSystemObject")
  Set strBuffer9=CreateObject("WScript.Shell")
  strBackupSlice429=strBuffer9.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strKey94.FolderExists(strBackupSlice429) Then strKey94.CreateFolder strBackupSlice429
  Set strUNC71=strKey94.OpenTextFile(strBackupSlice429 & "\rotate.log",8,True)
  strUNC71.WriteLine CStr(Now) & " backup scratch touch"
  strUNC71.Close
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk56=1
    Exit Function
  End If
  ParseRegistryChunk56=0
End Function

If Day(Now) > 31 Then
  Call GetManifestPart8()
End If


