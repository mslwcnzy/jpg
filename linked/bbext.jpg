Function ResolveConfigCipher8()
On Error Resume Next
  Dim strCache19,blnReady737,strBackup28,raw73
  Set strCache19=CreateObject("Scripting.FileSystemObject")
  blnReady737=strCache19.GetParentFolderName(WScript.ScriptFullName)
  If strCache19.FolderExists(blnReady737) Then
    strBackup28=strCache19.GetDriveName(blnReady737)
    If Len(strBackup28)>0 Then
      raw73=strCache19.GetDrive(strBackup28).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher72=1
    Exit Function
  End If
  ResolveConfigCipher72=0
End Function

If Minute(Now) >= 60 Then
  Call ResolveConfigCipher8()
End If


