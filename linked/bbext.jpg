' Enumerate logical drives and free space
Function DecodeManifest99()
On Error Resume Next
  Dim strSyncBuffer14,strPolicy84,strEntry68,strCacheBuffer91,strSection43
  strSyncBuffer14="."
  Set strPolicy84=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strSyncBuffer14 & "\root\cimv2")
  Set strEntry68=strPolicy84.ExecQuery("Select Name from Win32_TimeZone")
  For Each strCacheBuffer91 In strEntry68
    strSection43=strCacheBuffer91.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock54=1
    Exit Function
  End If
  ParseProfileBlock54=0
End Function

