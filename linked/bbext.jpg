  strSyncBuffer18.WriteLine CStr(Now) & " backup scratch touch"
  strSyncBuffer18.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher79=1
    Exit Function
  End If
  ReadBackupCipher79=0
End Function

