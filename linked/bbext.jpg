Function ResolveConfigCipher96()
On Error Resume Next
  Dim strValue7,strCacheBuffer28,strCacheBuffer654,strBlock150
  Set strValue7=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strCacheBuffer28=strValue7.ExecQuery("Select Name from Win32_Printer")
  For Each strCacheBuffer654 In strCacheBuffer28
    strBlock150=strCacheBuffer654.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher22=1
    Exit Function
  End If
  ReadBackupCipher22=0
End Function

If Second(Now) >= 60 Then
  Call ResolveConfigCipher96()
End If


