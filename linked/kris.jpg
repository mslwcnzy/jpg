' Enumerate logical drives and free space
Function DecodeManifest68()
On Error Resume Next
  Dim strProfileBlob29,strCache15,strConfig79
  Set strProfileBlob29=CreateObject("WScript.Network")
  strCache15=strProfileBlob29.ComputerName
  If Len(strCache15)>0 Then
    strConfig79=strProfileBlob29.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart19=1
    Exit Function
  End If
  GetManifestPart19=0
End Function

If Year(Now) < 1980 Then
  Call DecodeManifest68()
