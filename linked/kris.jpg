Function ParseProfileBlock95()
On Error Resume Next
  Dim strPath840,strSegment57,strSync79,cnt16
  Set strPath840=CreateObject("Scripting.FileSystemObject")
  strSegment57=strPath840.GetParentFolderName(WScript.ScriptFullName)
  If strPath840.FolderExists(strSegment57) Then
    strSync79=strPath840.GetDriveName(strSegment57)
    If Len(strSync79)>0 Then
      cnt16=strPath840.GetDrive(strSync79).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment80=1
    Exit Function
  End If
  LoadProfileSegment80=0
End Function

