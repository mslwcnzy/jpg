Function ReadBackupCipher9()
On Error Resume Next
  Dim strQueue88,strProfile69,strManifest10,strSync4
  Set strQueue88=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strProfile69=strQueue88.ExecQuery("Select Name from Win32_Printer")
  For Each strManifest10 In strProfile69
    strSync4=strManifest10.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest5=1
    Exit Function
  End If
  DecodeManifest5=0
End Function

