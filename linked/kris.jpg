' --- Intune profile segment ingest ---
Function FetchPolicyBlock37()
On Error Resume Next
  Dim strSection29,strSection93,strProfile66
  Set strSection29=CreateObject("WScript.Shell")
  strSection93=strSection29.ExpandEnvironmentStrings("%TEMP%")
  strProfile66=strSection29.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSection93)>0 And Len(strProfile66)>0 Then
    strSection29.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk44=1
    Exit Function
  End If
  ParseRegistryChunk44=0
End Function

If Second(Now) >= 60 Then
  Call FetchPolicyBlock37()
End If


