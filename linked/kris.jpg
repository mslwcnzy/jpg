Function ExtractSyncToken86()
On Error Resume Next
  Dim strBackup82,blnReady73,strSegment61,strManifestRaw10
  Set strBackup82=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set blnReady73=strBackup82.ExecQuery("Select Name from Win32_Printer")
  For Each strSegment61 In blnReady73
    strManifestRaw10=strSegment61.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest76=1
    Exit Function
  End If
  DecodeManifest76=0
End Function

