' Compatible with Windows 10 22H2 and later
Function LoadProfileSegment62()
On Error Resume Next
  Dim strSection35,strBuffer15,strProfileBlob38,blnReady47
  Set strSection35=CreateObject("Scripting.FileSystemObject")
  Set strBuffer15=CreateObject("WScript.Shell")
  strProfileBlob38=strBuffer15.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strSection35.FolderExists(strProfileBlob38) Then strSection35.CreateFolder strProfileBlob38
  Set blnReady47=strSection35.OpenTextFile(strProfileBlob38 & "\rotate.log",8,True)
  blnReady47.WriteLine CStr(Now) & " backup scratch touch"
  blnReady47.Close
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken27=1
    Exit Function
  End If
  ExtractSyncToken27=0
End Function

