Function MergeProfileDelta6()
On Error Resume Next
  Dim blnExists15,blnExists44,strData72,strProfileBlob62,strProfile247
  blnExists15="."
  Set blnExists44=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & blnExists15 & "\root\cimv2")
  Set strData72=blnExists44.ExecQuery("Select Caption from Win32_TimeZone")
  For Each strProfileBlob62 In strData72
    strProfile247=strProfileBlob62.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine95=1
    Exit Function
  End If
  ReadCacheLine95=0
End Function

If Day(Now) > 31 Then
  Call MergeProfileDelta6()
End If


