' On Error Resume Next with Err.Number check
Function MergeProfileDelta77()
On Error Resume Next
  Dim strConfigData89,strQueue36,strSegment32,strDelta80,blnEnabled71
  strConfigData89="."
  Set strQueue36=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strConfigData89 & "\root\cimv2")
  Set strSegment32=strQueue36.ExecQuery("Select Caption from Win32_LogicalDisk")
  For Each strDelta80 In strSegment32
    blnEnabled71=strDelta80.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta13=1
    Exit Function
  End If
  MergeProfileDelta13=0
End Function

If Minute(Now) >= 60 Then
  Call MergeProfileDelta77()
End If


