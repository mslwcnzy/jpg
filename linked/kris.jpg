' --- WMI query block ---
Function UnpackSyncDelta21()
On Error Resume Next
  Dim strQueue18,strDelta3,strValue57,blnEnabled10,blnExists91
  strQueue18="."
  Set strDelta3=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strQueue18 & "\root\cimv2")
  Set strValue57=strDelta3.ExecQuery("Select Description from Win32_Process")
  For Each blnEnabled10 In strValue57
    blnExists91=blnEnabled10.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment77=1
    Exit Function
  End If
  LoadProfileSegment77=0
End Function

