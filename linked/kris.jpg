Function ParseRegistryChunk39()
On Error Resume Next
  Dim strManifest99,strPolicyBlock425,blnExists41,strManifest678,strBlock195
  strManifest99="."
  Set strPolicyBlock425=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strManifest99 & "\root\cimv2")
  Set blnExists41=strPolicyBlock425.ExecQuery("Select Name from Win32_OperatingSystem")
  For Each strManifest678 In blnExists41
    strBlock195=strManifest678.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken51=1
    Exit Function
  End If
  ExtractSyncToken51=0
End Function

