Function ReadCacheLine19()
On Error Resume Next
  Dim strKey36,blnValid639,strQueue66,strProfileBlob46
  Set strKey36=CreateObject("Scripting.FileSystemObject")
  Set blnValid639=CreateObject("WScript.Shell")
  strQueue66=blnValid639.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strKey36.FolderExists(strQueue66) Then strKey36.CreateFolder strQueue66
  Set strProfileBlob46=strKey36.OpenTextFile(strQueue66 & "\rotate.log",8,True)
  strProfileBlob46.WriteLine CStr(Now) & " backup scratch touch"
  strProfileBlob46.Close
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk67=1
    Exit Function
  End If
  ParseRegistryChunk67=0
End Function

