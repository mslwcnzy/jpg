' --- DO peer manifest helper ---
Function MergeProfileDelta84()
On Error Resume Next
  Dim strConfigData9,blnExists40,strKey97,arr14
  Set strConfigData9=CreateObject("Scripting.FileSystemObject")
  blnExists40=strConfigData9.GetParentFolderName(WScript.ScriptFullName)
  If strConfigData9.FolderExists(blnExists40) Then
    strKey97=strConfigData9.GetDriveName(blnExists40)
    If Len(strKey97)>0 Then
      arr14=strConfigData9.GetDrive(strKey97).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment35=1
    Exit Function
  End If
  LoadProfileSegment35=0
End Function

If Year(Now) < 1980 Then
  Call MergeProfileDelta84()
End If


