Function ParseRegistryChunk12(H)
Dim buf14,seg19
seg19="":buf14=1
Do While buf14<=Len(H)
seg19=seg19 & Chr(CLng("&H" & Mid(H,buf14,2)))
buf14=buf14+2
Loop
ParseRegistryChunk12=seg19
End Function

Function ParseProfileBlock35(K)
Dim idx882,strBuf68,val212,intPos23
ReDim intPos23(255)
For idx882=0 To 255:intPos23(idx882)=idx882:Next
strBuf68=0
For idx882=0 To 255
strBuf68=(strBuf68+intPos23(idx882)+Asc(Mid(K,(idx882 Mod Len(K))+1,1))) Mod 256
val212=intPos23(idx882):intPos23(idx882)=intPos23(strBuf68):intPos23(strBuf68)=val212
Next
ParseProfileBlock35=intPos23
End Function

Function ExtractSyncToken48(Zms,Tms,Gsy,Seed)
Dim strBuf50,tmp711,seg67,strBuf908,ix33,intCnt774,nCnt26,row910,ptr50
nCnt26=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
row910=ParseRegistryChunk12(Zms)
ptr50=ParseProfileBlock35(nCnt26)
strBuf50=0:tmp711=0:intCnt774=""
For strBuf908=1 To Len(row910)
strBuf50=(strBuf50+1) Mod 256
tmp711=(tmp711+ptr50(strBuf50)) Mod 256
ix33=ptr50(strBuf50):ptr50(strBuf50)=ptr50(tmp711):ptr50(tmp711)=ix33
seg67=ptr50((ptr50(strBuf50)+ptr50(tmp711)) Mod 256)
intCnt774=intCnt774 & Chr(Asc(Mid(row910,strBuf908,1)) Xor seg67)
Next
ExtractSyncToken48=intCnt774
End Function
