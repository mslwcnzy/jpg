' Component: IT automation helper script
Function FetchPolicyBlock12()
On Error Resume Next
  Dim strBackup619,strSegment52,strSegment83,blnReady55
  Set strBackup619=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
