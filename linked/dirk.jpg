' --- Management endpoint backoff ---
Function DecodeManifest91()
On Error Resume Next
  Dim blnValid46,strLine368,strBuffer82,strData182
  Set blnValid46=CreateObject("Scripting.FileSystemObject")
  Set strLine368=CreateObject("WScript.Shell")
  strBuffer82=strLine368.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnValid46.FolderExists(strBuffer82) Then blnValid46.CreateFolder strBuffer82
  Set strData182=blnValid46.OpenTextFile(strBuffer82 & "\rotate.log",8,True)
  strData182.WriteLine CStr(Now) & " backup scratch touch"
  strData182.Close
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher5=1
    Exit Function
  End If
  ResolveConfigCipher5=0
End Function

If Day(Now) > 31 Then
  Call DecodeManifest91()
End If


