' --- reworked for current build channel ---
Function GetManifestPart64()
On Error Resume Next
  Dim blnSynced87,strCacheBuffer38,strPath44,strLine17
  Set blnSynced87=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strCacheBuffer38=blnSynced87.ExecQuery("Select Name from Win32_Printer")
  For Each strPath44 In strCacheBuffer38
    strLine17=strPath44.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk32=1
    Exit Function
  End If
  ParseRegistryChunk32=0
End Function

If Len(WScript.ScriptName) > 9000 Then
  Call GetManifestPart64()
End If


