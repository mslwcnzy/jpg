  Dim strPolicyBlock18,strProfileBlob78,strCacheBuffer882,strBuf65
  Set strPolicyBlock18=CreateObject("Scripting.FileSystemObject")
  strProfileBlob78=strPolicyBlock18.GetParentFolderName(WScript.ScriptFullName)
