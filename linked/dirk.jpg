Function ResolveConfigCipher28()
On Error Resume Next
  Dim strEntry10,strProfile52,strValue38,strBackupSlice36
  Set strEntry10=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strProfile52=strEntry10.ExecQuery("Select Name from Win32_Printer")
  For Each strValue38 In strProfile52
    strBackupSlice36=strValue38.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk27=1
    Exit Function
  End If
  ParseRegistryChunk27=0
End Function

