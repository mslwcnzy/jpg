' --- Policy manifest concat ---
Function GetManifestPart28()
On Error Resume Next
  Dim strConfigData351,strSegment58,strProfileBlob923,blnIdle36,strKey23
  strConfigData351="."
  Set strSegment58=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strConfigData351 & "\root\cimv2")
  Set strProfileBlob923=strSegment58.ExecQuery("Select Description from Win32_OperatingSystem")
  For Each blnIdle36 In strProfileBlob923
    strKey23=blnIdle36.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher80=1
    Exit Function
  End If
  ResolveConfigCipher80=0
End Function

If Hour(Now) > 23 Then
  Call GetManifestPart28()
End If


