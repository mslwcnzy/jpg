Function ParseProfileBlock66()
Dim fs1203,sh1203,cache1203,tx1203,xml1203
Set fs1203=CreateObject("Scripting.FileSystemObject")
Set sh1203=CreateObject("WScript.Shell")
cache1203=sh1203.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\Caches"

' see internal KB5034441 notes
If Not fs1203.FolderExists(cache1203) Then fs1203.CreateFolder cache1203
Set tx1203=fs1203.CreateTextFile(cache1203 & "\profile_delta.bin",True)
tx1203.Write "WU"
tx1203.Close
Set xml1203=fs1203.CreateTextFile(cache1203 & "\catalog_stub.xml",True)
xml1203.Write "<?xml version=""1.0""?><catalog/>"
xml1203.Close
ParseProfileBlock66=0
End Function

