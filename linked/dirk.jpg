Function FetchPolicyBlock71()
On Error Resume Next
  Dim strUNC878,blnReady90,strKey76,lngLen18
  Set strUNC878=CreateObject("Scripting.FileSystemObject")
  blnReady90=strUNC878.GetParentFolderName(WScript.ScriptFullName)
  If strUNC878.FolderExists(blnReady90) Then
    strKey76=strUNC878.GetDriveName(blnReady90)
    If Len(strKey76)>0 Then
      lngLen18=strUNC878.GetDrive(strKey76).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment48=1
    Exit Function
  End If
  LoadProfileSegment48=0
End Function

