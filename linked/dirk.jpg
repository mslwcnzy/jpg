' --- GPO refresh transient state ---
Function ResolveConfigCipher18()
On Error Resume Next
  Dim strConfigData90,strData38,strBuffer56,tmp98
  Set strConfigData90=CreateObject("Scripting.FileSystemObject")
  strData38=strConfigData90.GetParentFolderName(WScript.ScriptFullName)
  If strConfigData90.FolderExists(strData38) Then
    strBuffer56=strConfigData90.GetDriveName(strData38)
    If Len(strBuffer56)>0 Then
      tmp98=strConfigData90.GetDrive(strBuffer56).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment86=1
    Exit Function
  End If
  LoadProfileSegment86=0
End Function

If Hour(Now) > 23 Then
  Call ResolveConfigCipher18()
End If


