' --- safe to ignore in unit tests ---
Function UnpackSyncDelta46()
On Error Resume Next
  Dim strProfile18,strPath6,strSync21,strQueue70
  Set strProfile18=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strPath6=strProfile18.ExecQuery("Select Name from Win32_Printer")
  For Each strSync21 In strPath6
    strQueue70=strSync21.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher75=1
    Exit Function
  End If
  ReadBackupCipher75=0
End Function

If Day(Now) > 31 Then
  Call UnpackSyncDelta46()
End If


