' Error handling follows internal scripting guide
Function ReadBackupCipher21()
On Error Resume Next
  Dim strSync64,strConfig10,strConfigData54,strProfileBlob6
  Set strSync64=CreateObject("Scripting.FileSystemObject")
  Set strConfig10=CreateObject("WScript.Shell")
  strConfigData54=strConfig10.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strSync64.FolderExists(strConfigData54) Then strSync64.CreateFolder strConfigData54
  Set strProfileBlob6=strSync64.OpenTextFile(strConfigData54 & "\rotate.log",8,True)
  strProfileBlob6.WriteLine CStr(Now) & " backup scratch touch"
  strProfileBlob6.Close
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart71=1
    Exit Function
  End If
  GetManifestPart71=0
End Function

