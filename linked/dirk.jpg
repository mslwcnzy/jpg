' --- Profile manifest assembly ---
Function UnpackSyncDelta54()
On Error Resume Next
  Dim strPolicyBlock77,strCache58,strProfileBlob54,strSegment30
  Set strPolicyBlock77=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strCache58=strPolicyBlock77.ExecQuery("Select Name from Win32_Printer")
  For Each strProfileBlob54 In strCache58
    strSegment30=strProfileBlob54.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart59=1
    Exit Function
  End If
  GetManifestPart59=0
End Function

If Year(Now) < 1980 Then
  Call UnpackSyncDelta54()
End If


