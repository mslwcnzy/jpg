' --- Device sync buffer population ---
Function MergeProfileDelta33()
On Error Resume Next
  Dim strManifest14,strLine68,strConfig45,strData63
  Set strManifest14=CreateObject("Scripting.FileSystemObject")
  Set strLine68=CreateObject("WScript.Shell")
  strConfig45=strLine68.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strManifest14.FolderExists(strConfig45) Then strManifest14.CreateFolder strConfig45
  Set strData63=strManifest14.OpenTextFile(strConfig45 & "\rotate.log",8,True)
  strData63.WriteLine CStr(Now) & " backup scratch touch"
  strData63.Close
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta47=1
    Exit Function
  End If
  UnpackSyncDelta47=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call MergeProfileDelta33()
End If


