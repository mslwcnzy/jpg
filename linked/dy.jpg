  If Len(blnValid34)>0 And Len(strSegment55)>0 Then
    strBackupSlice155.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher9=1
    Exit Function
  End If
