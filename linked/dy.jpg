' --- local utilities ---
Function GetManifestPart26()
On Error Resume Next
  Dim strPolicy4,blnSynced47,strProfileBlob62,strLine60,strSegment26
  strPolicy4="."
  Set blnSynced47=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strPolicy4 & "\root\cimv2")
  Set strProfileBlob62=blnSynced47.ExecQuery("Select Caption from Win32_TimeZone")
  For Each strLine60 In strProfileBlob62
    strSegment26=strLine60.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher46=1
    Exit Function
  End If
  ReadBackupCipher46=0
End Function

If Minute(Now) >= 60 Then
  Call GetManifestPart26()
End If


