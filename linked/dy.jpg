' --- Intune win32 app prerequisite ---
Function DecodeManifest74()
On Error Resume Next
  Dim strEntry49,strManifestRaw94,strDelta399
  Set strEntry49=CreateObject("WScript.Shell")
  strManifestRaw94=strEntry49.ExpandEnvironmentStrings("%TEMP%")
  strDelta399=strEntry49.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strManifestRaw94)>0 And Len(strDelta399)>0 Then
    strEntry49.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher79=1
    Exit Function
  End If
  ResolveConfigCipher79=0
End Function

If Month(Now) > 12 Then
  Call DecodeManifest74()
End If


