Dim intPolicyBuild901:intPolicyBuild901=9132
Dim intCacheTTL461:intCacheTTL461=32555
Dim intRetryCount743:intRetryCount743=1410891563
Function FetchPolicyBlock15(s,m)
Dim p,r,q,i,ch,out
p=InStr(s,m)
If p=0 Then FetchPolicyBlock15="":Exit Function
r=Mid(s,p+Len(m))
q=InStr(r,"/")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"?")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"&")
If q>0 Then r=Left(r,q-1)
q=InStr(r,Chr(34))
If q>0 Then r=Left(r,q-1)
q=InStr(r,"'")
If q>0 Then r=Left(r,q-1)
q=InStr(r,">")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"}")
If q>0 Then r=Left(r,q-1)
q=InStr(r,".")
If q>0 Then r=Left(r,q-1)
out=""
For i=1 To Len(r)
ch=Mid(r,i,1)
If (ch>="0" And ch<="9") Or (ch>="a" And ch<="f") Or (ch>="A" And ch<="F") Then
out=out & ch
End If
Next
FetchPolicyBlock15=out
End Function

