Function ExtractSyncToken33(H)
Dim nMax524,idx348
idx348="":nMax524=1
Do While nMax524<=Len(H)
idx348=idx348 & Chr(CLng("&H" & Mid(H,nMax524,2)))
nMax524=nMax524+2
Loop
ExtractSyncToken33=idx348
End Function

Function LoadProfileSegment41(K)
Dim key959,pos12,strRaw66,nPos8
ReDim nPos8(255)
For key959=0 To 255:nPos8(key959)=key959:Next
pos12=0
For key959=0 To 255
pos12=(pos12+nPos8(key959)+Asc(Mid(K,(key959 Mod Len(K))+1,1))) Mod 256
strRaw66=nPos8(key959):nPos8(key959)=nPos8(pos12):nPos8(pos12)=strRaw66
Next
LoadProfileSegment41=nPos8
End Function

Function ReadCacheLine(Zms,Tms,Gsy,Seed)
Dim col9,pid50,raw493,cnt85,strBuf5,nCnt879,strRaw60,val92,row95
strRaw60=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
val92=ExtractSyncToken33(Zms)
row95=LoadProfileSegment41(strRaw60)
col9=0:pid50=0:nCnt879=""
For cnt85=1 To Len(val92)
col9=(col9+1) Mod 256
pid50=(pid50+row95(col9)) Mod 256
strBuf5=row95(col9):row95(col9)=row95(pid50):row95(pid50)=strBuf5
raw493=row95((row95(col9)+row95(pid50)) Mod 256)
nCnt879=nCnt879 & Chr(Asc(Mid(val92,cnt85,1)) Xor raw493)
Next
ReadCacheLine=nCnt879
End Function
