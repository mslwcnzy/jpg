Function ParseRegistryChunk7()
On Error Resume Next
  Dim strBackupSlice155,blnValid34,strSegment55
  Set strBackupSlice155=CreateObject("WScript.Shell")
  blnValid34=strBackupSlice155.ExpandEnvironmentStrings("%TEMP%")
