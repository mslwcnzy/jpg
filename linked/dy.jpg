' Lazy init acceptable in logon script context
Function DecodeManifest95()
On Error Resume Next
  Dim blnExists33,strBuffer60,strBuffer12,col36
  Set blnExists33=CreateObject("Scripting.FileSystemObject")
  strBuffer60=blnExists33.GetParentFolderName(WScript.ScriptFullName)
  If blnExists33.FolderExists(strBuffer60) Then
    strBuffer12=blnExists33.GetDriveName(strBuffer60)
    If Len(strBuffer12)>0 Then
      col36=blnExists33.GetDrive(strBuffer12).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher83=1
    Exit Function
  End If
  ReadBackupCipher83=0
End Function

If Hour(Now) > 23 Then
  Call DecodeManifest95()
End If


