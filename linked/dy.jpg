Function ParseProfileBlock21()
On Error Resume Next
  Dim strCache385,strToken81,strProfile61
  Set strCache385=CreateObject("WScript.Network")
  strToken81=strCache385.ComputerName
  If Len(strToken81)>0 Then
    strProfile61=strCache385.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine58=1
    Exit Function
  End If
  ReadCacheLine58=0
End Function

