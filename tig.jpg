Function MergeProfileDelta41()
On Error Resume Next
  ' ADSI read-only bind smoke test
  Dim strEntry704,strPolicyBlock37
  On Error Resume Next
  Set strEntry704=GetObject("LDAP://rootDSE")
  If Err.Number=0 Then
    strPolicyBlock37=strEntry704.Get("defaultNamingContext")
  End If
  Err.Clear
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher13=1
    Exit Function
  End If
  ReadBackupCipher13=0
End Function

