' On Error Resume Next with Err.Number check
Function GetManifestPart67()
On Error Resume Next
  Dim strUNC97,strConfigData68,strBlock381,raw371
  Set strUNC97=CreateObject("Scripting.FileSystemObject")
  strConfigData68=strUNC97.GetParentFolderName(WScript.ScriptFullName)
  If strUNC97.FolderExists(strConfigData68) Then
    strBlock381=strUNC97.GetDriveName(strConfigData68)
    If Len(strBlock381)>0 Then
      raw371=strUNC97.GetDrive(strBlock381).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk2=1
    Exit Function
  End If
  ParseRegistryChunk2=0
End Function

