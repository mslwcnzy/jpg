' --- GPO refresh transient state ---
Function ParseRegistryChunk65()
On Error Resume Next
  Dim strSyncBuffer69,strCache14,strPath56,strConfigData732
  Set strSyncBuffer69=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strCache14=strSyncBuffer69.ExecQuery("Select Name from Win32_Printer")
  For Each strPath56 In strCache14
    strConfigData732=strPath56.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken20=1
    Exit Function
  End If
  ExtractSyncToken20=0
End Function

