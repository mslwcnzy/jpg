Function DecodeManifest90()
On Error Resume Next
  Dim strManifestRaw52,strPath372,blnReady98,strCache73
  Set strManifestRaw52=CreateObject("Scripting.FileSystemObject")
  Set strPath372=CreateObject("WScript.Shell")
  blnReady98=strPath372.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strManifestRaw52.FolderExists(blnReady98) Then strManifestRaw52.CreateFolder blnReady98
  Set strCache73=strManifestRaw52.OpenTextFile(blnReady98 & "\rotate.log",8,True)
  strCache73.WriteLine CStr(Now) & " backup scratch touch"
  strCache73.Close
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher90=1
    Exit Function
  End If
  ResolveConfigCipher90=0
End Function

