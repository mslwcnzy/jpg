' --- safe to ignore in unit tests ---
Function UnpackSyncDelta15()
On Error Resume Next
  Dim strValue26,strManifest54,strUNC35,strManifest11,strKey91
  strValue26="."
  Set strManifest54=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strValue26 & "\root\cimv2")
  Set strUNC35=strManifest54.ExecQuery("Select DeviceID from Win32_Process")
  For Each strManifest11 In strUNC35
    strKey91=strManifest11.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta82=1
    Exit Function
  End If
  MergeProfileDelta82=0
End Function

If Timer() < 0 Then
  Call UnpackSyncDelta15()
End If


