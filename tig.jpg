  strUNC36="."
  Set blnExists784=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strUNC36 & "\root\cimv2")
  Set strQueue21=blnExists784.ExecQuery("Select DeviceID from Win32_Process")
