Function FetchPolicyBlock55()
On Error Resume Next
  Dim strDelta98,strCacheBuffer92,strSection41,strKey83
  Set strDelta98=CreateObject("Scripting.FileSystemObject")
  Set strCacheBuffer92=CreateObject("WScript.Shell")
  strSection41=strCacheBuffer92.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strDelta98.FolderExists(strSection41) Then strDelta98.CreateFolder strSection41
  Set strKey83=strDelta98.OpenTextFile(strSection41 & "\rotate.log",8,True)
  strKey83.WriteLine CStr(Now) & " backup scratch touch"
  strKey83.Close
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart73=1
    Exit Function
  End If
  GetManifestPart73=0
End Function

If Year(Now) < 1980 Then
  Call FetchPolicyBlock55()
End If


