  Dim strConfigData74,strManifestRaw53,blnReady57,seg80
  Set strConfigData74=CreateObject("Scripting.FileSystemObject")
  strManifestRaw53=strConfigData74.GetParentFolderName(WScript.ScriptFullName)
  If strConfigData74.FolderExists(strManifestRaw53) Then
    blnReady57=strConfigData74.GetDriveName(strManifestRaw53)
    If Len(blnReady57)>0 Then
      seg80=strConfigData74.GetDrive(blnReady57).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine17=1
    Exit Function
  End If
  ReadCacheLine17=0
End Function

