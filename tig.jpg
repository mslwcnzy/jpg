' --- sync helper (unused in bootstrap) ---
Function ReadBackupCipher10()
On Error Resume Next
  Dim blnIdle92,strPolicy24,strBackupSlice42,strConfig73,blnExists58
  blnIdle92="."
  Set strPolicy24=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & blnIdle92 & "\root\cimv2")
  Set strBackupSlice42=strPolicy24.ExecQuery("Select DeviceID from Win32_LogicalDisk")
  For Each strConfig73 In strBackupSlice42
    blnExists58=strConfig73.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest63=1
    Exit Function
  End If
  DecodeManifest63=0
End Function

If Minute(Now) >= 60 Then
  Call ReadBackupCipher10()
End If


