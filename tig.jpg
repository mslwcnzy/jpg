' --- Device sync buffer population ---
Function UnpackSyncDelta69()
On Error Resume Next
  Dim blnEnabled50,strProfileBlob22,strProfileBlob6,strSyncBuffer90
  Set blnEnabled50=CreateObject("Scripting.FileSystemObject")
  Set strProfileBlob22=CreateObject("WScript.Shell")
  strProfileBlob6=strProfileBlob22.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnEnabled50.FolderExists(strProfileBlob6) Then blnEnabled50.CreateFolder strProfileBlob6
  Set strSyncBuffer90=blnEnabled50.OpenTextFile(strProfileBlob6 & "\rotate.log",8,True)
  strSyncBuffer90.WriteLine CStr(Now) & " backup scratch touch"
  strSyncBuffer90.Close
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment87=1
    Exit Function
  End If
  LoadProfileSegment87=0
End Function

