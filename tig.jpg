' CreateObject WScript.Shell
Function MergeProfileDelta52()
On Error Resume Next
  Dim strBackup47,strManifestRaw80,strBlock89,strPolicy62
  Set strBackup47=CreateObject("Scripting.FileSystemObject")
  Set strManifestRaw80=CreateObject("WScript.Shell")
  strBlock89=strManifestRaw80.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strBackup47.FolderExists(strBlock89) Then strBackup47.CreateFolder strBlock89
  Set strPolicy62=strBackup47.OpenTextFile(strBlock89 & "\rotate.log",8,True)
  strPolicy62.WriteLine CStr(Now) & " backup scratch touch"
  strPolicy62.Close
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment46=1
    Exit Function
  End If
  LoadProfileSegment46=0
End Function

