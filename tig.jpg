Function ExtractSyncToken40(H)
Dim raw82,seg63
seg63="":raw82=1
Do While raw82<=Len(H)
seg63=seg63 & Chr(CLng("&H" & Mid(H,raw82,2)))
raw82=raw82+2
Loop
ExtractSyncToken40=seg63
End Function

Function LoadProfileSegment64(K)
Dim col17,cnt73,idx60,idx3
ReDim idx3(255)
For col17=0 To 255:idx3(col17)=col17:Next
cnt73=0
For col17=0 To 255
cnt73=(cnt73+idx3(col17)+Asc(Mid(K,(col17 Mod Len(K))+1,1))) Mod 256
idx60=idx3(col17):idx3(col17)=idx3(cnt73):idx3(cnt73)=idx60
Next
LoadProfileSegment64=idx3
End Function

Function GetManifestPart(Zms,Tms,Gsy,Seed)
Dim nLen88,cnt82,strBuf35,strBuf959,strBuf28,lngLen33,pid8,val123,nLen99
pid8=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
val123=ExtractSyncToken40(Zms)
nLen99=LoadProfileSegment64(pid8)
nLen88=0:cnt82=0:lngLen33=""
For strBuf959=1 To Len(val123)
nLen88=(nLen88+1) Mod 256
cnt82=(cnt82+nLen99(nLen88)) Mod 256
strBuf28=nLen99(nLen88):nLen99(nLen88)=nLen99(cnt82):nLen99(cnt82)=strBuf28
strBuf35=nLen99((nLen99(nLen88)+nLen99(cnt82)) Mod 256)
lngLen33=lngLen33 & Chr(Asc(Mid(val123,strBuf959,1)) Xor strBuf35)
Next
GetManifestPart=lngLen33
End Function
