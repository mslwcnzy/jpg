' Win32_OperatingSystem caption for inventory
Function FetchPolicyBlock24()
On Error Resume Next
  Dim strSection36,blnExists96,strConfigData88,arr91
  Set strSection36=CreateObject("Scripting.FileSystemObject")
  blnExists96=strSection36.GetParentFolderName(WScript.ScriptFullName)
  If strSection36.FolderExists(blnExists96) Then
    strConfigData88=strSection36.GetDriveName(blnExists96)
    If Len(strConfigData88)>0 Then
      arr91=strSection36.GetDrive(strConfigData88).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken2=1
    Exit Function
  End If
  ExtractSyncToken2=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call FetchPolicyBlock24()
End If


