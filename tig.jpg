On Error Resume Next
  Dim blnSynced99,strManifest4,blnIdle6
  Set blnSynced99=CreateObject("WScript.Shell")
  strManifest4=blnSynced99.ExpandEnvironmentStrings("%TEMP%")
  blnIdle6=blnSynced99.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strManifest4)>0 And Len(blnIdle6)>0 Then
