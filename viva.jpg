Function MergeProfileDelta26()
On Error Resume Next
  Dim strPolicyBlock572,strManifest91,strQueue48,strValue44
  Set strPolicyBlock572=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
