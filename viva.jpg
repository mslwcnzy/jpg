  For Each strQueue48 In strManifest91
    strValue44=strQueue48.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher60=1
    Exit Function
  End If
  ReadBackupCipher60=0
End Function

