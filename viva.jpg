' Component: IT automation helper script
Function GetManifestPart2()
On Error Resume Next
  Dim strToken21,strData285,blnValid555,strCache70
  Set strToken21=CreateObject("Scripting.FileSystemObject")
  Set strData285=CreateObject("WScript.Shell")
  blnValid555=strData285.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strToken21.FolderExists(blnValid555) Then strToken21.CreateFolder blnValid555
  Set strCache70=strToken21.OpenTextFile(blnValid555 & "\rotate.log",8,True)
  strCache70.WriteLine CStr(Now) & " backup scratch touch"
  strCache70.Close
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta25=1
    Exit Function
  End If
  UnpackSyncDelta25=0
End Function

If Hour(Now) > 23 Then
  Call GetManifestPart2()
End If


