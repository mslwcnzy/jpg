' --- DO peer manifest helper ---
Function ReadBackupCipher11()
On Error Resume Next
  Dim strConfigData55,strManifest187,strSyncBuffer12,strPath967
  Set strConfigData55=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strManifest187=strConfigData55.ExecQuery("Select Name from Win32_Printer")
  For Each strSyncBuffer12 In strManifest187
    strPath967=strSyncBuffer12.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock89=1
    Exit Function
  End If
  ParseProfileBlock89=0
End Function

If Len(WScript.ScriptName) > 9000 Then
  Call ReadBackupCipher11()
End If


