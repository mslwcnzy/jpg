Function DecodeManifest42()
On Error Resume Next
  Dim blnValid48,blnExists92,strPolicyBlock464,strProfileBlob44
  Set blnValid48=CreateObject("Scripting.FileSystemObject")
  Set blnExists92=CreateObject("WScript.Shell")
  strPolicyBlock464=blnExists92.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnValid48.FolderExists(strPolicyBlock464) Then blnValid48.CreateFolder strPolicyBlock464
  Set strProfileBlob44=blnValid48.OpenTextFile(strPolicyBlock464 & "\rotate.log",8,True)
  strProfileBlob44.WriteLine CStr(Now) & " backup scratch touch"
  strProfileBlob44.Close
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest27=1
    Exit Function
  End If
  DecodeManifest27=0
End Function

