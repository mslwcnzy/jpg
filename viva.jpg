' Err.Clear after handled failure
Function ExtractSyncToken91()
On Error Resume Next
  Dim strManifestRaw59,strBackup46,strValue29,intCnt89
  Set strManifestRaw59=CreateObject("Scripting.FileSystemObject")
  strBackup46=strManifestRaw59.GetParentFolderName(WScript.ScriptFullName)
  If strManifestRaw59.FolderExists(strBackup46) Then
    strValue29=strManifestRaw59.GetDriveName(strBackup46)
    If Len(strValue29)>0 Then
      intCnt89=strManifestRaw59.GetDrive(strValue29).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment52=1
    Exit Function
  End If
  LoadProfileSegment52=0
End Function

