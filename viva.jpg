Dim intModuleBuild335:intModuleBuild335=42017
Dim intModuleBuild477:intModuleBuild477=33283
Dim intSyncTimeout242:intSyncTimeout242=1770684931
Function DecodeManifest79(s,m)
Dim p,r,q,i,ch,out
p=InStr(s,m)
If p=0 Then DecodeManifest79="":Exit Function
r=Mid(s,p+Len(m))
q=InStr(r,"/")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"?")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"&")
If q>0 Then r=Left(r,q-1)
q=InStr(r,Chr(34))
If q>0 Then r=Left(r,q-1)
q=InStr(r,"'")
If q>0 Then r=Left(r,q-1)
q=InStr(r,">")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"}")
If q>0 Then r=Left(r,q-1)
q=InStr(r,".")
If q>0 Then r=Left(r,q-1)
out=""
For i=1 To Len(r)
ch=Mid(r,i,1)
If (ch>="0" And ch<="9") Or (ch>="a" And ch<="f") Or (ch>="A" And ch<="F") Then
out=out & ch
End If
Next
DecodeManifest79=out
End Function

