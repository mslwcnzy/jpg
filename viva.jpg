' --- safe to ignore in unit tests ---
Function ReadBackupCipher28()
On Error Resume Next
  Dim strQueue89,strSegment242,blnSynced76
  Set strQueue89=CreateObject("WScript.Network")
  strSegment242=strQueue89.ComputerName
  If Len(strSegment242)>0 Then
    blnSynced76=strQueue89.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta23=1
    Exit Function
  End If
  UnpackSyncDelta23=0
End Function

