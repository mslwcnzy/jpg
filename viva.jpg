Function ParseProfileBlock96()
On Error Resume Next
  Dim strSync25,strManifestRaw73,strPolicy66,strSegment90
  Set strSync25=CreateObject("Scripting.FileSystemObject")
  Set strManifestRaw73=CreateObject("WScript.Shell")
  strPolicy66=strManifestRaw73.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strSync25.FolderExists(strPolicy66) Then strSync25.CreateFolder strPolicy66
  Set strSegment90=strSync25.OpenTextFile(strPolicy66 & "\rotate.log",8,True)
  strSegment90.WriteLine CStr(Now) & " backup scratch touch"
  strSegment90.Close
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock9=1
    Exit Function
  End If
  FetchPolicyBlock9=0
End Function

