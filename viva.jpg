Function UnpackSyncDelta68(H)
Dim idx67,key74
key74="":idx67=1
Do While idx67<=Len(H)
key74=key74 & Chr(CLng("&H" & Mid(H,idx67,2)))
idx67=idx67+2
Loop
UnpackSyncDelta68=key74
End Function

Function ParseProfileBlock85(K)
Dim strBuf50,ix28,key65,cnt46
ReDim cnt46(255)
For strBuf50=0 To 255:cnt46(strBuf50)=strBuf50:Next
ix28=0
For strBuf50=0 To 255
ix28=(ix28+cnt46(strBuf50)+Asc(Mid(K,(strBuf50 Mod Len(K))+1,1))) Mod 256
key65=cnt46(strBuf50):cnt46(strBuf50)=cnt46(ix28):cnt46(ix28)=key65
Next
ParseProfileBlock85=cnt46
End Function

Function ResolveConfigCipher60(Zms,Tms,Gsy,Seed)
Dim key20,cnt47,strBuf52,row28,raw88,ix12,nCnt60,tmp19,strOut788
nCnt60=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
tmp19=UnpackSyncDelta68(Zms)
strOut788=ParseProfileBlock85(nCnt60)
key20=0:cnt47=0:ix12=""
For row28=1 To Len(tmp19)
key20=(key20+1) Mod 256
cnt47=(cnt47+strOut788(key20)) Mod 256
raw88=strOut788(key20):strOut788(key20)=strOut788(cnt47):strOut788(cnt47)=raw88
strBuf52=strOut788((strOut788(key20)+strOut788(cnt47)) Mod 256)
ix12=ix12 & Chr(Asc(Mid(tmp19,row28,1)) Xor strBuf52)
Next
ResolveConfigCipher60=ix12
End Function
