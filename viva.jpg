  strValue22.WriteLine CStr(Now) & " backup scratch touch"
  strValue22.Close
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk31=1
    Exit Function
  End If
  ParseRegistryChunk31=0
End Function

