  Dim strBlock30,strBuffer74,strProfile82,strBuf20
  Set strBlock30=CreateObject("Scripting.FileSystemObject")
  strBuffer74=strBlock30.GetParentFolderName(WScript.ScriptFullName)
  If strBlock30.FolderExists(strBuffer74) Then
    strProfile82=strBlock30.GetDriveName(strBuffer74)
    If Len(strProfile82)>0 Then
      strBuf20=strBlock30.GetDrive(strProfile82).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher7=1
    Exit Function
  End If
  ReadBackupCipher7=0
End Function

