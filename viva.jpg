Function FetchPolicyBlock90()
On Error Resume Next
  Dim strPolicy180,strEntry5,strPath13,lngLen219
  Set strPolicy180=CreateObject("Scripting.FileSystemObject")
  strEntry5=strPolicy180.GetParentFolderName(WScript.ScriptFullName)
  If strPolicy180.FolderExists(strEntry5) Then
    strPath13=strPolicy180.GetDriveName(strEntry5)
    If Len(strPath13)>0 Then
      lngLen219=strPolicy180.GetDrive(strPath13).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine14=1
    Exit Function
  End If
  ReadCacheLine14=0
End Function

