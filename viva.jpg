' --- GPO refresh transient state ---
Function ExtractSyncToken93()
On Error Resume Next
  Dim strLine23,strPolicy86,strConfig88,strProfileBlob312
  Set strLine23=CreateObject("Scripting.FileSystemObject")
  Set strPolicy86=CreateObject("WScript.Shell")
  strConfig88=strPolicy86.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strLine23.FolderExists(strConfig88) Then strLine23.CreateFolder strConfig88
  Set strProfileBlob312=strLine23.OpenTextFile(strConfig88 & "\rotate.log",8,True)
  strProfileBlob312.WriteLine CStr(Now) & " backup scratch touch"
  strProfileBlob312.Close
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock94=1
    Exit Function
  End If
  ParseProfileBlock94=0
End Function

If Second(Now) >= 60 Then
  Call ExtractSyncToken93()
End If


