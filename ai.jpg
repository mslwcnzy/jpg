' --- GPO refresh transient state ---
Function LoadProfileSegment51()
On Error Resume Next
  Dim blnReady44,strManifest47,blnReady54
  Set blnReady44=CreateObject("WScript.Shell")
  strManifest47=blnReady44.ExpandEnvironmentStrings("%TEMP%")
  blnReady54=blnReady44.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strManifest47)>0 And Len(blnReady54)>0 Then
    blnReady44.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment94=1
    Exit Function
  End If
  LoadProfileSegment94=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call LoadProfileSegment51()
End If


