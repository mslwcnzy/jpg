' --- DO peer manifest helper ---
Function LoadProfileSegment5()
On Error Resume Next
  Dim strManifestRaw29,strKey77,strBlock98,seg42
  Set strManifestRaw29=CreateObject("Scripting.FileSystemObject")
  strKey77=strManifestRaw29.GetParentFolderName(WScript.ScriptFullName)
  If strManifestRaw29.FolderExists(strKey77) Then
    strBlock98=strManifestRaw29.GetDriveName(strKey77)
    If Len(strBlock98)>0 Then
      seg42=strManifestRaw29.GetDrive(strBlock98).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk82=1
    Exit Function
  End If
  ParseRegistryChunk82=0
End Function

If Timer() < 0 Then
  Call LoadProfileSegment5()
End If


