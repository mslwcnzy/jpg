Function MergeProfileDelta2()
On Error Resume Next
  Dim strQueue75,strCache82,strToken47,blnReady50,strCache438
  strQueue75="."
  Set strCache82=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strQueue75 & "\root\cimv2")
  Set strToken47=strCache82.ExecQuery("Select Description from Win32_OperatingSystem")
  For Each blnReady50 In strToken47
    strCache438=blnReady50.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta61=1
    Exit Function
  End If
  MergeProfileDelta61=0
End Function

