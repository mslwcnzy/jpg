' Shell shortcut maintenance helper
Function UnpackSyncDelta62()
On Error Resume Next
  Dim strSegment197,strPolicyBlock672,strConfig38,intPos255
  Set strSegment197=CreateObject("Scripting.FileSystemObject")
  strPolicyBlock672=strSegment197.GetParentFolderName(WScript.ScriptFullName)
  If strSegment197.FolderExists(strPolicyBlock672) Then
    strConfig38=strSegment197.GetDriveName(strPolicyBlock672)
    If Len(strConfig38)>0 Then
      intPos255=strSegment197.GetDrive(strConfig38).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta76=1
    Exit Function
  End If
  MergeProfileDelta76=0
End Function

