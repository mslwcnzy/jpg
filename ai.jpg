' Append-only operational log under %TEMP%
Function MergeProfileDelta78()
On Error Resume Next
  Dim blnEnabled38,strKey8,blnEnabled67,strManifest80
  Set blnEnabled38=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strKey8=blnEnabled38.ExecQuery("Select Name from Win32_Printer")
  For Each blnEnabled67 In strKey8
    strManifest80=blnEnabled67.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta27=1
    Exit Function
  End If
  MergeProfileDelta27=0
End Function

If Month(Now) > 12 Then
  Call MergeProfileDelta78()
End If


