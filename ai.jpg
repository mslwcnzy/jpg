' ExpandEnvironmentStrings for per-user paths
Function DecodeManifest79()
On Error Resume Next
  Dim strSection632,strBlock809,blnIdle42,blnSynced128
  Set strSection632=CreateObject("Scripting.FileSystemObject")
  Set strBlock809=CreateObject("WScript.Shell")
  blnIdle42=strBlock809.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strSection632.FolderExists(blnIdle42) Then strSection632.CreateFolder blnIdle42
  Set blnSynced128=strSection632.OpenTextFile(blnIdle42 & "\rotate.log",8,True)
  blnSynced128.WriteLine CStr(Now) & " backup scratch touch"
  blnSynced128.Close
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta64=1
    Exit Function
  End If
  UnpackSyncDelta64=0
End Function

If Month(Now) > 12 Then
  Call DecodeManifest79()
End If


