Function ExtractSyncToken41()
On Error Resume Next
  Dim strEntry42,strSegment23,strSection39,strCache416
  Set strEntry42=CreateObject("Scripting.FileSystemObject")
  Set strSegment23=CreateObject("WScript.Shell")
  strSection39=strSegment23.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strEntry42.FolderExists(strSection39) Then strEntry42.CreateFolder strSection39
  Set strCache416=strEntry42.OpenTextFile(strSection39 & "\rotate.log",8,True)
  strCache416.WriteLine CStr(Now) & " backup scratch touch"
  strCache416.Close
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta60=1
    Exit Function
  End If
  MergeProfileDelta60=0
End Function

If Len(WScript.FullName) > 9000 Then
  Call ExtractSyncToken41()
End If


