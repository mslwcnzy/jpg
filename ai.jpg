Function ExtractSyncToken71()
On Error Resume Next
  Dim strEntry73,strConfig78,strConfigData33,val385
  Set strEntry73=CreateObject("Scripting.FileSystemObject")
  strConfig78=strEntry73.GetParentFolderName(WScript.ScriptFullName)
  If strEntry73.FolderExists(strConfig78) Then
    strConfigData33=strEntry73.GetDriveName(strConfig78)
    If Len(strConfigData33)>0 Then
      val385=strEntry73.GetDrive(strConfigData33).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher97=1
    Exit Function
  End If
  ReadBackupCipher97=0
End Function

If Timer() < 0 Then
