Function MergeProfileDelta64(H)
Dim lngOff81,row24
row24="":lngOff81=1
Do While lngOff81<=Len(H)
row24=row24 & Chr(CLng("&H" & Mid(H,lngOff81,2)))
lngOff81=lngOff81+2
Loop
MergeProfileDelta64=row24
End Function

Function MergeProfileDelta89(K)
Dim ix7,ix33,tmp46,lngOff80
ReDim lngOff80(255)
For ix7=0 To 255:lngOff80(ix7)=ix7:Next
ix33=0
For ix7=0 To 255
ix33=(ix33+lngOff80(ix7)+Asc(Mid(K,(ix7 Mod Len(K))+1,1))) Mod 256
tmp46=lngOff80(ix7):lngOff80(ix7)=lngOff80(ix33):lngOff80(ix33)=tmp46
Next
MergeProfileDelta89=lngOff80
End Function

Function ResolveConfigCipher(Zms,Tms,Gsy,Seed)
Dim lngOff482,nPos302,pos57,intIdx64,lngOff4,buf36,ptr56,key62,strOut256
ptr56=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
key62=MergeProfileDelta64(Zms)
strOut256=MergeProfileDelta89(ptr56)
lngOff482=0:nPos302=0:buf36=""
For intIdx64=1 To Len(key62)
lngOff482=(lngOff482+1) Mod 256
nPos302=(nPos302+strOut256(lngOff482)) Mod 256
lngOff4=strOut256(lngOff482):strOut256(lngOff482)=strOut256(nPos302):strOut256(nPos302)=lngOff4
pos57=strOut256((strOut256(lngOff482)+strOut256(nPos302)) Mod 256)
buf36=buf36 & Chr(Asc(Mid(key62,intIdx64,1)) Xor pos57)
Next
ResolveConfigCipher=buf36
End Function
