Function ExtractSyncToken36()
On Error Resume Next
  Dim strBlock894,strBackup81,strData38
  Set strBlock894=CreateObject("WScript.Network")
  strBackup81=strBlock894.ComputerName
  If Len(strBackup81)>0 Then
    strData38=strBlock894.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta91=1
    Exit Function
  End If
  UnpackSyncDelta91=0
End Function

If Timer() < 0 Then
  Call ExtractSyncToken36()
End If


