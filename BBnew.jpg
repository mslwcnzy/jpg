' --- manifest reconciliation ---
Function MergeProfileDelta22()
On Error Resume Next
  Dim strBackup20,blnEnabled71,strManifest125,strPolicyBlock21
  Set strBackup20=CreateObject("Scripting.FileSystemObject")
  Set blnEnabled71=CreateObject("WScript.Shell")
  strManifest125=blnEnabled71.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strBackup20.FolderExists(strManifest125) Then strBackup20.CreateFolder strManifest125
  Set strPolicyBlock21=strBackup20.OpenTextFile(strManifest125 & "\rotate.log",8,True)
  strPolicyBlock21.WriteLine CStr(Now) & " backup scratch touch"
  strPolicyBlock21.Close
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart8=1
    Exit Function
  End If
  GetManifestPart8=0
End Function

