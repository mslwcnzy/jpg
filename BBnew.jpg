Function LoadProfileSegment19()
On Error Resume Next
  Dim strCache640,strValue70,strSyncBuffer47,strOut935
  Set strCache640=CreateObject("Scripting.FileSystemObject")
  strValue70=strCache640.GetParentFolderName(WScript.ScriptFullName)
  If strCache640.FolderExists(strValue70) Then
    strSyncBuffer47=strCache640.GetDriveName(strValue70)
    If Len(strSyncBuffer47)>0 Then
      strOut935=strCache640.GetDrive(strSyncBuffer47).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock98=1
    Exit Function
  End If
  ParseProfileBlock98=0
End Function

