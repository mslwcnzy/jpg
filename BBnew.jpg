' --- sync helper (unused in bootstrap) ---
Function ReadCacheLine88()
On Error Resume Next
  Dim strCache22,strManifest71,strConfig41,strValue76,strData32
  strCache22="."
  Set strManifest71=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strCache22 & "\root\cimv2")
  Set strConfig41=strManifest71.ExecQuery("Select DeviceID from Win32_LogicalDisk")
  For Each strValue76 In strConfig41
    strData32=strValue76.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken2=1
    Exit Function
  End If
  ExtractSyncToken2=0
End Function

If Minute(Now) >= 60 Then
  Call ReadCacheLine88()
End If


