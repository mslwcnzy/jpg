Function ParseRegistryChunk73()
On Error Resume Next
  Dim strQueue40,strCache29,strBlock30,strConfig39,strBackup71
  strQueue40="."
  Set strCache29=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strQueue40 & "\root\cimv2")
  Set strBlock30=strCache29.ExecQuery("Select Description from Win32_TimeZone")
  For Each strConfig39 In strBlock30
    strBackup71=strConfig39.Description
  Next
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock21=1
    Exit Function
  End If
  FetchPolicyBlock21=0
End Function

