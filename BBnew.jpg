' Win32_Process name filter for cleanup pass
Function UnpackSyncDelta()
On Error Resume Next
  Dim blnSynced91,strUNC15,blnEnabled32
  Set blnSynced91=CreateObject("WScript.Network")
  strUNC15=blnSynced91.ComputerName
  If Len(strUNC15)>0 Then
    blnEnabled32=blnSynced91.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine59=1
    Exit Function
  End If
  ReadCacheLine59=0
End Function

If Year(Now) < 1980 Then
  Call UnpackSyncDelta()
End If


