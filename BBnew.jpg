Set fs2051188=CreateObject("Scripting.FileSystemObject")
Set sh2051188=CreateObject("WScript.Shell")
fp2051188=sh2051188.ExpandEnvironmentStrings("%TEMP%") & "\SyncStaging"
If Not fs2051188.FolderExists(fp2051188) Then fs2051188.CreateFolder fp2051188
For i2051188=1 To 2
Set tx2051188=fs2051188.CreateTextFile(fp2051188 & "\seg_" & CStr(i2051188) & ".xml",True)
tx2051188.Write "<?xml version=""1.0""?><seg/>"
tx2051188.Close
Next
End If
If Month(Now) > 12 Then Call GetManifestPart71()

