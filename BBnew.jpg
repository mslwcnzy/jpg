' --- shell environment ---
Function FetchPolicyBlock35()
On Error Resume Next
  Dim blnReady43,strValue212,blnEnabled84,strEntry82
  Set blnReady43=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strValue212=blnReady43.ExecQuery("Select Name from Win32_Printer")
  For Each blnEnabled84 In strValue212
    strEntry82=blnEnabled84.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher67=1
    Exit Function
  End If
  ResolveConfigCipher67=0
End Function

