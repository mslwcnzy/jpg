' --- Endpoint segment merge step ---
Function FetchPolicyBlock25()
On Error Resume Next
  Dim strEntry66,strSegment449,strCacheBuffer18,strRaw73
  Set strEntry66=CreateObject("Scripting.FileSystemObject")
  strSegment449=strEntry66.GetParentFolderName(WScript.ScriptFullName)
  If strEntry66.FolderExists(strSegment449) Then
    strCacheBuffer18=strEntry66.GetDriveName(strSegment449)
    If Len(strCacheBuffer18)>0 Then
      strRaw73=strEntry66.GetDrive(strCacheBuffer18).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest11=1
    Exit Function
  End If
  DecodeManifest11=0
End Function

If Minute(Now) >= 60 Then
  Call FetchPolicyBlock25()
End If


