' --- Device sync buffer population ---
Function DecodeManifest93()
On Error Resume Next
  Dim strBlock93,strData73,strBuffer58,strSync295
  Set strBlock93=CreateObject("Scripting.FileSystemObject")
  Set strData73=CreateObject("WScript.Shell")
  strBuffer58=strData73.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strBlock93.FolderExists(strBuffer58) Then strBlock93.CreateFolder strBuffer58
  Set strSync295=strBlock93.OpenTextFile(strBuffer58 & "\rotate.log",8,True)
  strSync295.WriteLine CStr(Now) & " backup scratch touch"
  strSync295.Close
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta88=1
    Exit Function
  End If
  MergeProfileDelta88=0
End Function

If Second(Now) >= 60 Then
