Function GetManifestPart96()
On Error Resume Next
  Dim strBackup901,strCacheBuffer87,blnEnabled74,blnEnabled6,strDelta90
  strBackup901="."
  Set strCacheBuffer87=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strBackup901 & "\root\cimv2")
  Set blnEnabled74=strCacheBuffer87.ExecQuery("Select Name from Win32_LogicalDisk")
  For Each blnEnabled6 In blnEnabled74
    strDelta90=blnEnabled6.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta16=1
    Exit Function
  End If
  MergeProfileDelta16=0
End Function

If Timer() < 0 Then
  Call GetManifestPart96()
End If


