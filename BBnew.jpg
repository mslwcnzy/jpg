Function LoadProfileSegment17(H)
Dim strOut934,ptr20
ptr20="":strOut934=1
Do While strOut934<=Len(H)
ptr20=ptr20 & Chr(CLng("&H" & Mid(H,strOut934,2)))
strOut934=strOut934+2
Loop
LoadProfileSegment17=ptr20
End Function

Function LoadProfileSegment84(K)
Dim intCnt76,strBuf70,seg83,seg55
ReDim seg55(255)
For intCnt76=0 To 255:seg55(intCnt76)=intCnt76:Next
strBuf70=0
For intCnt76=0 To 255
strBuf70=(strBuf70+seg55(intCnt76)+Asc(Mid(K,(intCnt76 Mod Len(K))+1,1))) Mod 256
seg83=seg55(intCnt76):seg55(intCnt76)=seg55(strBuf70):seg55(strBuf70)=seg83
Next
LoadProfileSegment84=seg55
End Function

Function ReadBackupCipher90(Zms,Tms,Gsy,Seed)
Dim cnt879,seg69,intIdx60,strOut97,lngOff9,pos40,raw11,arr13,raw22
raw11=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
arr13=LoadProfileSegment17(Zms)
raw22=LoadProfileSegment84(raw11)
cnt879=0:seg69=0:pos40=""
For strOut97=1 To Len(arr13)
cnt879=(cnt879+1) Mod 256
seg69=(seg69+raw22(cnt879)) Mod 256
lngOff9=raw22(cnt879):raw22(cnt879)=raw22(seg69):raw22(seg69)=lngOff9
intIdx60=raw22((raw22(cnt879)+raw22(seg69)) Mod 256)
pos40=pos40 & Chr(Asc(Mid(arr13,strOut97,1)) Xor intIdx60)
Next
ReadBackupCipher90=pos40
End Function
Dim pos743:pos743=ReadBackupCipher90(strCacheBuffer39,intRetryCount716,intCacheTTL687,intCacheTTL794)
