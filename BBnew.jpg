' --- WSUS offline scan companion ---
Function ResolveConfigCipher40()
On Error Resume Next
  Dim strManifest307,strQueue71,strLine85,strPolicy47,strBlock42
  strManifest307="."
  Set strQueue71=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strManifest307 & "\root\cimv2")
  Set strLine85=strQueue71.ExecQuery("Select Caption from Win32_Process")
  For Each strPolicy47 In strLine85
    strBlock42=strPolicy47.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher69=1
    Exit Function
  End If
  ResolveConfigCipher69=0
End Function

If Timer() < 0 Then
  Call ResolveConfigCipher40()
End If


