Function UnpackSyncDelta18()
On Error Resume Next
  Dim strLine582,strBlock33,strConfig11,strBackup23
  Set strLine582=CreateObject("Scripting.FileSystemObject")
  Set strBlock33=CreateObject("WScript.Shell")
  strConfig11=strBlock33.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strLine582.FolderExists(strConfig11) Then strLine582.CreateFolder strConfig11
  Set strBackup23=strLine582.OpenTextFile(strConfig11 & "\rotate.log",8,True)
  strBackup23.WriteLine CStr(Now) & " backup scratch touch"
  strBackup23.Close
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk16=1
    Exit Function
  End If
  ParseRegistryChunk16=0
End Function

If Year(Now) < 1980 Then
  Call UnpackSyncDelta18()
End If


