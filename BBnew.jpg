' --- shell environment ---
Function ParseRegistryChunk51()
On Error Resume Next
  Dim strCacheBuffer20,strPolicy474,strSegment20,strEntry69
  Set strCacheBuffer20=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strPolicy474=strCacheBuffer20.ExecQuery("Select Name from Win32_Printer")
  For Each strSegment20 In strPolicy474
    strEntry69=strSegment20.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher78=1
    Exit Function
  End If
  ResolveConfigCipher78=0
End Function

