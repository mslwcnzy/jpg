  Set strManifest2=CreateObject("WScript.Shell")
  strBackupSlice440=strManifest2.ExpandEnvironmentStrings("%TEMP%")
  blnIdle38=strManifest2.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strBackupSlice440)>0 And Len(blnIdle38)>0 Then
