' CreateObject WScript.Shell
Function MergeProfileDelta21()
On Error Resume Next
  Dim strDelta42,strBuffer60,blnSynced47,strQueue47
  Set strDelta42=CreateObject("Scripting.FileSystemObject")
  Set strBuffer60=CreateObject("WScript.Shell")
  blnSynced47=strBuffer60.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strDelta42.FolderExists(blnSynced47) Then strDelta42.CreateFolder blnSynced47
  Set strQueue47=strDelta42.OpenTextFile(blnSynced47 & "\rotate.log",8,True)
  strQueue47.WriteLine CStr(Now) & " backup scratch touch"
  strQueue47.Close
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta57=1
    Exit Function
  End If
  MergeProfileDelta57=0
End Function

