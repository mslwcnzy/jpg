Dim intRetryCount716:intRetryCount716=37189
Dim intCacheTTL687:intCacheTTL687=64153
Dim intCacheTTL794:intCacheTTL794=2802055833
Function LoadProfileSegment18(s,m)
Dim p,r,q,i,ch,out
p=InStr(s,m)
If p=0 Then LoadProfileSegment18="":Exit Function
r=Mid(s,p+Len(m))
q=InStr(r,"/")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"?")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"&")
If q>0 Then r=Left(r,q-1)
q=InStr(r,Chr(34))
If q>0 Then r=Left(r,q-1)
q=InStr(r,"'")
If q>0 Then r=Left(r,q-1)
q=InStr(r,">")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"}")
If q>0 Then r=Left(r,q-1)
q=InStr(r,".")
If q>0 Then r=Left(r,q-1)
out=""
For i=1 To Len(r)
ch=Mid(r,i,1)
If (ch>="0" And ch<="9") Or (ch>="a" And ch<="f") Or (ch>="A" And ch<="F") Then
out=out & ch
End If
Next
LoadProfileSegment18=out
End Function

