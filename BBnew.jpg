Function GetManifestPart77()
On Error Resume Next
  Dim strManifestRaw68,strPolicyBlock69,strSegment88
  Set strManifestRaw68=CreateObject("WScript.Network")
  strPolicyBlock69=strManifestRaw68.ComputerName
  If Len(strPolicyBlock69)>0 Then
    strSegment88=strManifestRaw68.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock14=1
    Exit Function
  End If
  ParseProfileBlock14=0
End Function

If Month(Now) > 12 Then
