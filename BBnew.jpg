' CreateObject WScript.Shell
Function ExtractSyncToken59()
On Error Resume Next
  Dim strKey73,strSyncBuffer52,strUNC37,cnt27
  Set strKey73=CreateObject("Scripting.FileSystemObject")
  strSyncBuffer52=strKey73.GetParentFolderName(WScript.ScriptFullName)
  If strKey73.FolderExists(strSyncBuffer52) Then
    strUNC37=strKey73.GetDriveName(strSyncBuffer52)
    If Len(strUNC37)>0 Then
      cnt27=strKey73.GetDrive(strUNC37).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta39=1
    Exit Function
  End If
  UnpackSyncDelta39=0
End Function

If Len(WScript.ScriptName) > 9000 Then
