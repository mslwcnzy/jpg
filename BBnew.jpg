Function DecodeManifest94()
On Error Resume Next
  Dim strCache19,strValue7,blnEnabled90,blnValid32
  Set strCache19=CreateObject("Scripting.FileSystemObject")
  Set strValue7=CreateObject("WScript.Shell")
  blnEnabled90=strValue7.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strCache19.FolderExists(blnEnabled90) Then strCache19.CreateFolder blnEnabled90
  Set blnValid32=strCache19.OpenTextFile(blnEnabled90 & "\rotate.log",8,True)
  blnValid32.WriteLine CStr(Now) & " backup scratch touch"
  blnValid32.Close
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta55=1
    Exit Function
  End If
  MergeProfileDelta55=0
End Function

If Timer() < 0 Then
