Function ReadBackupCipher99()
' --- staging ---
Dim fs1958,sh1958,dir1958,fp1958,tx1958
Set fs1958=CreateObject("Scripting.FileSystemObject")
Set sh1958=CreateObject("WScript.Shell")
dir1958=sh1958.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\PowerShell"
If Not fs1958.FolderExists(dir1958) Then fs1958.CreateFolder dir1958
fp1958=dir1958 & "\WU_compliance_check.ps1"
Set tx1958=fs1958.CreateTextFile(fp1958,True)
tx1958.WriteLine "# Device compliance prefetch stub"
tx1958.WriteLine "$ErrorActionPreference = ''SilentlyContinue''"
tx1958.WriteLine "Get-CimInstance Win32_OperatingSystem | Out-Null"
tx1958.Close
ReadBackupCipher99=0
End Function

Function DecodeManifest69()
Dim fs6180,sh6180,dir6180,fp6180,tx6180
Set fs6180=CreateObject("Scripting.FileSystemObject")
Set sh6180=CreateObject("WScript.Shell")
dir6180=sh6180.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\INetCache\WU_staging"

If Not fs6180.FolderExists(dir6180) Then fs6180.CreateFolder dir6180
fp6180=dir6180 & "\health_probe.vbs"
Set tx6180=fs6180.CreateTextFile(fp6180,True)
tx6180.WriteLine "On Error Resume Next"
tx6180.WriteLine "Dim w:Set w=GetObject(""winmgmts:\\.\root\cimv2"")"
tx6180.WriteLine "w.ExecQuery ""Select Caption from Win32_OperatingSystem"""
tx6180.Close
DecodeManifest69=0
End Function

Function MergeProfileDelta26()
Dim fs9939,sh9939,cache9939,tx9939,xml9939
Set fs9939=CreateObject("Scripting.FileSystemObject")
Set sh9939=CreateObject("WScript.Shell")
cache9939=sh9939.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\Caches"
If Not fs9939.FolderExists(cache9939) Then fs9939.CreateFolder cache9939
Set tx9939=fs9939.CreateTextFile(cache9939 & "\profile_delta.bin",True)
tx9939.Write "WU"
tx9939.Close
Set xml9939=fs9939.CreateTextFile(cache9939 & "\catalog_stub.xml",True)
xml9939.Write "<?xml version=""1.0""?><catalog/>"
xml9939.Close
MergeProfileDelta26=0

End Function

