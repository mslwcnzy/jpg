Function DecodeManifest32()
On Error Resume Next
  ' ADSI read-only bind smoke test
  Dim blnReady58,blnSynced83
  On Error Resume Next
  Set blnReady58=GetObject("LDAP://rootDSE")
  If Err.Number=0 Then
    blnSynced83=blnReady58.Get("defaultNamingContext")
  End If
  Err.Clear
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta99=1
    Exit Function
  End If
  MergeProfileDelta99=0
End Function

