Function FetchPolicyBlock65()
On Error Resume Next
  Dim strUNC93,strBlock391,strValue40
  Set strUNC93=CreateObject("WScript.Shell")
  strBlock391=strUNC93.ExpandEnvironmentStrings("%TEMP%")
