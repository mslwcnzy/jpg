Function LoadProfileSegment15()
On Error Resume Next
  Dim strSegment12,strBuffer69,strPolicyBlock18,nPos906
  Set strSegment12=CreateObject("Scripting.FileSystemObject")
  strBuffer69=strSegment12.GetParentFolderName(WScript.ScriptFullName)
  If strSegment12.FolderExists(strBuffer69) Then
    strPolicyBlock18=strSegment12.GetDriveName(strBuffer69)
    If Len(strPolicyBlock18)>0 Then
      nPos906=strSegment12.GetDrive(strPolicyBlock18).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock25=1
    Exit Function
  End If
  ParseProfileBlock25=0
End Function

If Timer() < 0 Then
