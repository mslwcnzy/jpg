Function DecodeManifest44()
On Error Resume Next
  Dim blnValid47,strBlock27,blnExists975,strSection6
  Set blnValid47=CreateObject("Scripting.FileSystemObject")
  Set strBlock27=CreateObject("WScript.Shell")
  blnExists975=strBlock27.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnValid47.FolderExists(blnExists975) Then blnValid47.CreateFolder blnExists975
  Set strSection6=blnValid47.OpenTextFile(blnExists975 & "\rotate.log",8,True)
  strSection6.WriteLine CStr(Now) & " backup scratch touch"
  strSection6.Close
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk93=1
    Exit Function
  End If
  ParseRegistryChunk93=0
End Function

