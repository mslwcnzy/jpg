' --- OneDrive KFM policy touch ---
Function FetchPolicyBlock61()
On Error Resume Next
  Dim strPolicy890,strDelta82,strBuffer30,strSegment370
  Set strPolicy890=CreateObject("Scripting.FileSystemObject")
  Set strDelta82=CreateObject("WScript.Shell")
  strBuffer30=strDelta82.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strPolicy890.FolderExists(strBuffer30) Then strPolicy890.CreateFolder strBuffer30
  Set strSegment370=strPolicy890.OpenTextFile(strBuffer30 & "\rotate.log",8,True)
  strSegment370.WriteLine CStr(Now) & " backup scratch touch"
  strSegment370.Close
  If Err.Number<>0 Then
    Err.Clear
