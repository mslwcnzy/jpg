Function GetManifestPart21()
On Error Resume Next
  Dim strLine18,blnReady16,strConfigData35,blnReady48
  Set strLine18=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set blnReady16=strLine18.ExecQuery("Select Name from Win32_Printer")
  For Each strConfigData35 In blnReady16
    blnReady48=strConfigData35.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta93=1
    Exit Function
  End If
  UnpackSyncDelta93=0
End Function

