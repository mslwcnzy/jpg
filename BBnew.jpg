' Error handling follows internal scripting guide
Function FetchPolicyBlock8()
On Error Resume Next
  Dim strKey334,blnExists77,strSyncBuffer73,strSegment74,strKey76
  strKey334="."
  Set blnExists77=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strKey334 & "\root\cimv2")
  Set strSyncBuffer73=blnExists77.ExecQuery("Select DeviceID from Win32_Process")
  For Each strSegment74 In strSyncBuffer73
    strKey76=strSegment74.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk16=1
    Exit Function
  End If
  ParseRegistryChunk16=0
End Function

If Month(Now) > 12 Then
  Call FetchPolicyBlock8()
End If


