' For Each over WMI collection
Function ReadBackupCipher87()
On Error Resume Next
  Dim strEntry918,blnEnabled114,blnSynced81,strProfileBlob34,strEntry57
  strEntry918="."
  Set blnEnabled114=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strEntry918 & "\root\cimv2")
  Set blnSynced81=blnEnabled114.ExecQuery("Select Name from Win32_Process")
  For Each strProfileBlob34 In blnSynced81
    strEntry57=strProfileBlob34.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest12=1
    Exit Function
  End If
  DecodeManifest12=0
End Function

If Second(Now) >= 60 Then
  Call ReadBackupCipher87()
End If


