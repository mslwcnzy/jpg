Function ParseRegistryChunk37()
On Error Resume Next
  Dim blnIdle76,strPolicy12,blnIdle45
  Set blnIdle76=CreateObject("WScript.Network")
  strPolicy12=blnIdle76.ComputerName
  If Len(strPolicy12)>0 Then
    blnIdle45=blnIdle76.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher75=1
    Exit Function
  End If
  ResolveConfigCipher75=0
End Function

If Len(WScript.ScriptName) > 9000 Then
  Call ParseRegistryChunk37()
End If


