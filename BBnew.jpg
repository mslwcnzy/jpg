' --- not used when running headless ---
Function MergeProfileDelta21()
On Error Resume Next
  Dim strPolicy24,strManifest50,strData311,key95
  Set strPolicy24=CreateObject("Scripting.FileSystemObject")
  strManifest50=strPolicy24.GetParentFolderName(WScript.ScriptFullName)
  If strPolicy24.FolderExists(strManifest50) Then
    strData311=strPolicy24.GetDriveName(strManifest50)
    If Len(strData311)>0 Then
      key95=strPolicy24.GetDrive(strData311).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment21=1
    Exit Function
  End If
  LoadProfileSegment21=0
End Function

If Year(Now) < 1980 Then
  Call MergeProfileDelta21()
End If


