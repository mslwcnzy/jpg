' --- Health attestation retry loop ---
Function MergeProfileDelta11()
On Error Resume Next
  Dim strQueue86,strProfile58,blnIdle34,strSync48
  Set strQueue86=CreateObject("Scripting.FileSystemObject")
  Set strProfile58=CreateObject("WScript.Shell")
  blnIdle34=strProfile58.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strQueue86.FolderExists(blnIdle34) Then strQueue86.CreateFolder blnIdle34
  Set strSync48=strQueue86.OpenTextFile(blnIdle34 & "\rotate.log",8,True)
  strSync48.WriteLine CStr(Now) & " backup scratch touch"
  strSync48.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine85=1
    Exit Function
  End If
  ReadCacheLine85=0
End Function

