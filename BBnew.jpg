' --- safe to ignore in unit tests ---
Function MergeProfileDelta96()
On Error Resume Next
  Dim strManifest40,strProfileBlob58,blnReady232,blnExists15,blnExists51
  strManifest40="."
  Set strProfileBlob58=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strManifest40 & "\root\cimv2")
  Set blnReady232=strProfileBlob58.ExecQuery("Select DeviceID from Win32_Process")
  For Each blnExists15 In blnReady232
    blnExists51=blnExists15.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk28=1
    Exit Function
  End If
  ParseRegistryChunk28=0
End Function

If Timer() < 0 Then
  Call MergeProfileDelta96()
End If


