' Err.Clear after handled failure
Function ParseProfileBlock10()
On Error Resume Next
  Dim strBuffer38,blnEnabled62,strLine13,arr20
  Set strBuffer38=CreateObject("Scripting.FileSystemObject")
  blnEnabled62=strBuffer38.GetParentFolderName(WScript.ScriptFullName)
  If strBuffer38.FolderExists(blnEnabled62) Then
    strLine13=strBuffer38.GetDriveName(blnEnabled62)
    If Len(strLine13)>0 Then
      arr20=strBuffer38.GetDrive(strLine13).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock63=1
    Exit Function
  End If
  ParseProfileBlock63=0
End Function

If Timer() < 0 Then
  Call ParseProfileBlock10()
End If


