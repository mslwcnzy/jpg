' Sub ShowFolderInfo style helper
Function ResolveConfigCipher87()
On Error Resume Next
  Dim strPolicy7,strBackup47,strBackupSlice29
  Set strPolicy7=CreateObject("WScript.Network")
  strBackup47=strPolicy7.ComputerName
  If Len(strBackup47)>0 Then
    strBackupSlice29=strPolicy7.UserDomain
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher99=1
    Exit Function
  End If
  ReadBackupCipher99=0
End Function

If Minute(Now) >= 60 Then
  Call ResolveConfigCipher87()
End If


