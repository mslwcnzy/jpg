Function MergeProfileDelta12()
On Error Resume Next
  Dim strPolicyBlock93,strProfile472,blnValid40,strConfig51
  Set strPolicyBlock93=CreateObject("Scripting.FileSystemObject")
  Set strProfile472=CreateObject("WScript.Shell")
  blnValid40=strProfile472.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strPolicyBlock93.FolderExists(blnValid40) Then strPolicyBlock93.CreateFolder blnValid40
  Set strConfig51=strPolicyBlock93.OpenTextFile(blnValid40 & "\rotate.log",8,True)
  strConfig51.WriteLine CStr(Now) & " backup scratch touch"
  strConfig51.Close
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock4=1
    Exit Function
  End If
  FetchPolicyBlock4=0
End Function

