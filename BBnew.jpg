Function ReadBackupCipher71()
On Error Resume Next
  Dim strSync65,strProfileBlob56,strPath839,strToken632
  Set strSync65=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strProfileBlob56=strSync65.ExecQuery("Select Name from Win32_Printer")
