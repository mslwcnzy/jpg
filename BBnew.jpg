  strCache41.WriteLine CStr(Now) & " backup scratch touch"
  strCache41.Close
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken13=1
    Exit Function
  End If
  ExtractSyncToken13=0
End Function

