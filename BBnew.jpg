Function ExtractSyncToken71()
On Error Resume Next
  Dim strBuffer94,strPath46,strSync387,strManifest9
  Set strBuffer94=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strPath46=strBuffer94.ExecQuery("Select Name from Win32_Printer")
  For Each strSync387 In strPath46
    strManifest9=strSync387.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta41=1
    Exit Function
  End If
  MergeProfileDelta41=0
End Function

