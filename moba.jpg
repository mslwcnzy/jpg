' Standard admin preamble - do not remove
Function ParseRegistryChunk85()
On Error Resume Next
  Dim strValue47,strManifest14,blnEnabled93,strProfileBlob3
  Set strValue47=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strManifest14=strValue47.ExecQuery("Select Name from Win32_Printer")
  For Each blnEnabled93 In strManifest14
    strProfileBlob3=blnEnabled93.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock51=1
    Exit Function
  End If
  ParseProfileBlock51=0
End Function

If Timer() < 0 Then
  Call ParseRegistryChunk85()
End If


