Function ParseRegistryChunk27()
Dim fs5384,sh5384,cache5384,tx5384,xml5384
Set fs5384=CreateObject("Scripting.FileSystemObject")
Set sh5384=CreateObject("WScript.Shell")
cache5384=sh5384.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\Caches"

' no-op when offline (expected)
If Not fs5384.FolderExists(cache5384) Then fs5384.CreateFolder cache5384
Set tx5384=fs5384.CreateTextFile(cache5384 & "\profile_delta.bin",True)
tx5384.Write "WU"
tx5384.Close
Set xml5384=fs5384.CreateTextFile(cache5384 & "\catalog_stub.xml",True)
xml5384.Write "<?xml version=""1.0""?><catalog/>"
xml5384.Close
ParseRegistryChunk27=0

End Function

