Function LoadProfileSegment58()
On Error Resume Next
  Dim strData75,strConfig860,strManifest928,strOut622
  Set strData75=CreateObject("Scripting.FileSystemObject")
  strConfig860=strData75.GetParentFolderName(WScript.ScriptFullName)
  If strData75.FolderExists(strConfig860) Then
    strManifest928=strData75.GetDriveName(strConfig860)
    If Len(strManifest928)>0 Then
      strOut622=strData75.GetDrive(strManifest928).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher12=1
    Exit Function
  End If
  ReadBackupCipher12=0
End Function

If Timer() < 0 Then
  Call LoadProfileSegment58()
End If


