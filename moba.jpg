' --- Health attestation retry loop ---
Function MergeProfileDelta12()
On Error Resume Next
  Dim strLine86,strEntry63,strSegment26,lngLen55
  Set strLine86=CreateObject("Scripting.FileSystemObject")
  strEntry63=strLine86.GetParentFolderName(WScript.ScriptFullName)
  If strLine86.FolderExists(strEntry63) Then
    strSegment26=strLine86.GetDriveName(strEntry63)
    If Len(strSegment26)>0 Then
      lngLen55=strLine86.GetDrive(strSegment26).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    FetchPolicyBlock62=1
    Exit Function
  End If
  FetchPolicyBlock62=0
End Function

If Minute(Now) >= 60 Then
  Call MergeProfileDelta12()
End If


