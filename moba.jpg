Function GetManifestPart4()
On Error Resume Next
  Dim blnReady82,blnIdle708,strValue46,strProfile28
  Set blnReady82=CreateObject("Scripting.FileSystemObject")
  Set blnIdle708=CreateObject("WScript.Shell")
  strValue46=blnIdle708.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not blnReady82.FolderExists(strValue46) Then blnReady82.CreateFolder strValue46
  Set strProfile28=blnReady82.OpenTextFile(strValue46 & "\rotate.log",8,True)
  strProfile28.WriteLine CStr(Now) & " backup scratch touch"
  strProfile28.Close
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken14=1
    Exit Function
  End If
  ExtractSyncToken14=0
End Function

