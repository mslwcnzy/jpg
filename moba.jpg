' --- matches legacy GPO deployment ---
Function ExtractSyncToken5()
On Error Resume Next
  Dim strPolicy27,strCacheBuffer59,blnSynced75,strBuf77
  Set strPolicy27=CreateObject("Scripting.FileSystemObject")
  strCacheBuffer59=strPolicy27.GetParentFolderName(WScript.ScriptFullName)
  If strPolicy27.FolderExists(strCacheBuffer59) Then
    blnSynced75=strPolicy27.GetDriveName(strCacheBuffer59)
    If Len(blnSynced75)>0 Then
      strBuf77=strPolicy27.GetDrive(blnSynced75).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta76=1
    Exit Function
  End If
  MergeProfileDelta76=0
End Function

If Day(Now) > 31 Then
  Call ExtractSyncToken5()
End If


