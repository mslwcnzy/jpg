' --- left after A/B rollout ---
Function MergeProfileDelta37()
On Error Resume Next
  Dim strToken13,strToken10,strKey66,strQueue95,strManifest48
  strToken13="."
  Set strToken10=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strToken13 & "\root\cimv2")
  Set strKey66=strToken10.ExecQuery("Select Caption from Win32_TimeZone")
  For Each strQueue95 In strKey66
    strManifest48=strQueue95.Caption
  Next
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment63=1
    Exit Function
  End If
  LoadProfileSegment63=0
End Function

If Second(Now) >= 60 Then
  Call MergeProfileDelta37()
End If


