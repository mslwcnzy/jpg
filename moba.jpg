Function UnpackSyncDelta73()
On Error Resume Next
  Dim strCache93,blnSynced11,strSegment61,strCache47
  Set strCache93=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set blnSynced11=strCache93.ExecQuery("Select Name from Win32_Printer")
  For Each strSegment61 In blnSynced11
    strCache47=strSegment61.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher98=1
    Exit Function
  End If
  ReadBackupCipher98=0
End Function

