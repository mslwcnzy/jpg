  Set blnSynced83=GetObject("LDAP://rootDSE")
  If Err.Number=0 Then
    strSegment78=blnSynced83.Get("defaultNamingContext")
  End If
  Err.Clear
  If Err.Number<>0 Then
    Err.Clear
    ReadCacheLine58=1
    Exit Function
  End If
  ReadCacheLine58=0
End Function

