  strData13.WriteLine CStr(Now) & " backup scratch touch"
  strData13.Close
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher71=1
    Exit Function
  End If
  ResolveConfigCipher71=0
End Function

