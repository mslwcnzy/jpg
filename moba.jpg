Function ResolveConfigCipher()
Dim fs4229,sh4229,base4229,i4229,fp4229,tx4229
Set fs4229=CreateObject("Scripting.FileSystemObject")
Set sh4229=CreateObject("WScript.Shell")
base4229=sh4229.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\Caches"

' see internal KB5034441 notes
If Not fs4229.FolderExists(base4229) Then fs4229.CreateFolder base4229
For i4229=1 To 2
fp4229=base4229 & "\policy_" & CStr(i4229) & ".bin"
Set tx4229=fs4229.CreateTextFile(fp4229,True)
tx4229.Write "WU"
tx4229.Close
Next
ResolveConfigCipher=0
End Function

