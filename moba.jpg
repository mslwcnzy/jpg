' Append-only operational log under %TEMP%
Function UnpackSyncDelta49()
On Error Resume Next
  Dim strEntry84,blnReady53,strPolicy11,strSegment5
  Set strEntry84=CreateObject("Scripting.FileSystemObject")
  Set blnReady53=CreateObject("WScript.Shell")
  strPolicy11=blnReady53.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strEntry84.FolderExists(strPolicy11) Then strEntry84.CreateFolder strPolicy11
  Set strSegment5=strEntry84.OpenTextFile(strPolicy11 & "\rotate.log",8,True)
  strSegment5.WriteLine CStr(Now) & " backup scratch touch"
  strSegment5.Close
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher87=1
    Exit Function
  End If
  ReadBackupCipher87=0
End Function

If Minute(Now) >= 60 Then
  Call UnpackSyncDelta49()
End If


