Function DecodeManifest11(Zms,Tms,Gsy,Seed)
Dim ix791,nMax758,strOut44,seg61,lngOff80,intIdx83,lngOff4
Dim intCnt663:intCnt663=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
ReDim raw53((Len(Zms)\2))
lngOff4=0
Do While lngOff4<Len(Zms)
raw53(lngOff4\2)=CLng("&H" & Mid(Zms,lngOff4+1,2))
lngOff4=lngOff4+2
Loop
ReDim buf39(255)
For ix791=0 To 255:buf39(ix791)=ix791:Next
nMax758=0
For ix791=0 To 255
nMax758=(nMax758+buf39(ix791)+Asc(Mid(intCnt663,(ix791 Mod Len(intCnt663))+1,1))) Mod 256
lngOff80=buf39(ix791):buf39(ix791)=buf39(nMax758):buf39(nMax758)=lngOff80
Next
ix791=0:nMax758=0:intIdx83=""
For seg61=0 To UBound(raw53)
ix791=(ix791+1) Mod 256
nMax758=(nMax758+buf39(ix791)) Mod 256
lngOff80=buf39(ix791):buf39(ix791)=buf39(nMax758):buf39(nMax758)=lngOff80
strOut44=buf39((buf39(ix791)+buf39(nMax758)) Mod 256)
intIdx83=intIdx83 & Chr(raw53(seg61) Xor strOut44)
Next
DecodeManifest11=intIdx83
End Function
