' Win32_OperatingSystem caption for inventory
Function LoadProfileSegment99()
On Error Resume Next
  Dim strBackupSlice44,strCacheBuffer9,blnSynced87,buf7
  Set strBackupSlice44=CreateObject("Scripting.FileSystemObject")
  strCacheBuffer9=strBackupSlice44.GetParentFolderName(WScript.ScriptFullName)
  If strBackupSlice44.FolderExists(strCacheBuffer9) Then
    blnSynced87=strBackupSlice44.GetDriveName(strCacheBuffer9)
    If Len(blnSynced87)>0 Then
      buf7=strBackupSlice44.GetDrive(blnSynced87).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ReadBackupCipher41=1
    Exit Function
  End If
  ReadBackupCipher41=0
End Function

