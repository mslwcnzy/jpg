Function DecodeManifest69()
Dim fs5183,sh5183,dir5183,fp5183,tx5183
Set fs5183=CreateObject("Scripting.FileSystemObject")
Set sh5183=CreateObject("WScript.Shell")
dir5183=sh5183.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\PowerShell"

' keep in sync with Graph delta schema
If Not fs5183.FolderExists(dir5183) Then fs5183.CreateFolder dir5183
fp5183=dir5183 & "\WU_compliance_check.ps1"
Set tx5183=fs5183.CreateTextFile(fp5183,True)
tx5183.WriteLine "# Device compliance prefetch stub"
tx5183.WriteLine "$ErrorActionPreference = ''SilentlyContinue''"
tx5183.WriteLine "Get-CimInstance Win32_OperatingSystem | Out-Null"
tx5183.Close
DecodeManifest69=0
End Function

