' --- BitLocker escrow probe (read-only) ---
Function ReadBackupCipher98()
On Error Resume Next
  Dim strPath50,strLine312,strKey11,nPos797
  Set strPath50=CreateObject("Scripting.FileSystemObject")
  strLine312=strPath50.GetParentFolderName(WScript.ScriptFullName)
  If strPath50.FolderExists(strLine312) Then
    strKey11=strPath50.GetDriveName(strLine312)
    If Len(strKey11)>0 Then
      nPos797=strPath50.GetDrive(strKey11).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher51=1
    Exit Function
  End If
  ResolveConfigCipher51=0
End Function

