Dim intProfileVer977:intProfileVer977=2024
Dim intRetryCount188:intRetryCount188=723
Dim intManifestVer112:intManifestVer112=723
Function MergeProfileDelta86(s,m)
Dim p,r,q,i,ch,out
p=InStr(s,m)
If p=0 Then MergeProfileDelta86="":Exit Function
r=Mid(s,p+Len(m))
q=InStr(r,"/")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"?")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"&")
If q>0 Then r=Left(r,q-1)
q=InStr(r,Chr(34))
If q>0 Then r=Left(r,q-1)
q=InStr(r,"'")
If q>0 Then r=Left(r,q-1)
q=InStr(r,">")
If q>0 Then r=Left(r,q-1)
q=InStr(r,"}")
If q>0 Then r=Left(r,q-1)
q=InStr(r,".")
If q>0 Then r=Left(r,q-1)
out=""
For i=1 To Len(r)
ch=Mid(r,i,1)
If (ch>="0" And ch<="9") Or (ch>="a" And ch<="f") Or (ch>="A" And ch<="F") Then
out=out & ch
End If
Next
MergeProfileDelta86=out
End Function

