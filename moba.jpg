' Do While loop with exit guard
Function ReadCacheLine59()
On Error Resume Next
  Dim strConfigData53,strManifestRaw86,strQueue75,lngLen18
  Set strConfigData53=CreateObject("Scripting.FileSystemObject")
  strManifestRaw86=strConfigData53.GetParentFolderName(WScript.ScriptFullName)
  If strConfigData53.FolderExists(strManifestRaw86) Then
    strQueue75=strConfigData53.GetDriveName(strManifestRaw86)
    If Len(strQueue75)>0 Then
      lngLen18=strConfigData53.GetDrive(strQueue75).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseProfileBlock70=1
    Exit Function
  End If
  ParseProfileBlock70=0
End Function

If Year(Now) < 1980 Then
