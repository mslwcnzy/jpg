' --- Reconcile staged policy block ---
Function ParseProfileBlock99()
On Error Resume Next
  Dim blnEnabled607,blnIdle68,blnExists617,blnValid96
  Set blnEnabled607=GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
  Set blnIdle68=blnEnabled607.ExecQuery("Select Name from Win32_Printer")
  For Each blnExists617 In blnIdle68
    blnValid96=blnExists617.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken67=1
    Exit Function
  End If
  ExtractSyncToken67=0
End Function

If Minute(Now) >= 60 Then
  Call ParseProfileBlock99()
End If


