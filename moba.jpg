Function ReadBackupCipher51(H)
Dim pid66,col67
col67="":pid66=1
Do While pid66<=Len(H)
col67=col67 & Chr(CLng("&H" & Mid(H,pid66,2)))
pid66=pid66+2
Loop
ReadBackupCipher51=col67
End Function

Function ReadBackupCipher17(K)
Dim buf51,nCnt4,val525,ptr471
ReDim ptr471(255)
For buf51=0 To 255:ptr471(buf51)=buf51:Next
nCnt4=0
For buf51=0 To 255
nCnt4=(nCnt4+ptr471(buf51)+Asc(Mid(K,(buf51 Mod Len(K))+1,1))) Mod 256
val525=ptr471(buf51):ptr471(buf51)=ptr471(nCnt4):ptr471(nCnt4)=val525
Next
ReadBackupCipher17=ptr471
End Function

Function ReadCacheLine59(Zms,Tms,Gsy,Seed)
Dim row48,col37,strOut51,row47,tmp95,ptr35,intPos19,strRaw145,strOut36
intPos19=CStr(Tms) & ":" & CStr(Gsy) & ":" & CStr(Seed)
strRaw145=ReadBackupCipher51(Zms)
strOut36=ReadBackupCipher17(intPos19)
row48=0:col37=0:ptr35=""
For row47=1 To Len(strRaw145)
row48=(row48+1) Mod 256
col37=(col37+strOut36(row48)) Mod 256
tmp95=strOut36(row48):strOut36(row48)=strOut36(col37):strOut36(col37)=tmp95
strOut51=strOut36((strOut36(row48)+strOut36(col37)) Mod 256)
ptr35=ptr35 & Chr(Asc(Mid(strRaw145,row47,1)) Xor strOut51)
Next
ReadCacheLine59=ptr35
End Function
