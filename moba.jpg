' On Error Resume Next with Err.Number check
Function UnpackSyncDelta69()
On Error Resume Next
  Dim blnEnabled50,strProfileBlob22,strProfileBlob6,nCnt90
  Set blnEnabled50=CreateObject("Scripting.FileSystemObject")
  strProfileBlob22=blnEnabled50.GetParentFolderName(WScript.ScriptFullName)
  If blnEnabled50.FolderExists(strProfileBlob22) Then
    strProfileBlob6=blnEnabled50.GetDriveName(strProfileBlob22)
    If Len(strProfileBlob6)>0 Then
      nCnt90=blnEnabled50.GetDrive(strProfileBlob6).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    LoadProfileSegment87=1
    Exit Function
  End If
  LoadProfileSegment87=0
End Function

