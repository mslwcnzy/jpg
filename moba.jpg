' --- Offline scan package stitch ---
Function ParseProfileBlock71()
On Error Resume Next
  Dim strValue24,strBlock36,strLine562,strPolicyBlock41
  Set strValue24=CreateObject("Scripting.FileSystemObject")
  Set strBlock36=CreateObject("WScript.Shell")
  strLine562=strBlock36.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strValue24.FolderExists(strLine562) Then strValue24.CreateFolder strLine562
  Set strPolicyBlock41=strValue24.OpenTextFile(strLine562 & "\rotate.log",8,True)
  strPolicyBlock41.WriteLine CStr(Now) & " backup scratch touch"
  strPolicyBlock41.Close
  If Err.Number<>0 Then
    Err.Clear
    ResolveConfigCipher73=1
    Exit Function
  End If
  ResolveConfigCipher73=0
End Function

If Weekday(Now) > 7 Then
