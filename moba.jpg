' Component: IT automation helper script
Function FetchPolicyBlock11()
On Error Resume Next
  Dim strLine33,strSegment73,strProfile20,strBuffer647,strSegment68
  strLine33="."
  Set strSegment73=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strLine33 & "\root\cimv2")
  Set strProfile20=strSegment73.ExecQuery("Select DeviceID from Win32_Process")
  For Each strBuffer647 In strProfile20
    strSegment68=strBuffer647.DeviceID
  Next
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken80=1
    Exit Function
  End If
  ExtractSyncToken80=0
End Function

If Timer() < 0 Then
  Call FetchPolicyBlock11()
End If


