Function FetchPolicyBlock84()
On Error Resume Next
  Dim strDelta32,strManifest65,strBackup58,buf8
  Set strDelta32=CreateObject("Scripting.FileSystemObject")
  strManifest65=strDelta32.GetParentFolderName(WScript.ScriptFullName)
  If strDelta32.FolderExists(strManifest65) Then
    strBackup58=strDelta32.GetDriveName(strManifest65)
    If Len(strBackup58)>0 Then
      buf8=strDelta32.GetDrive(strBackup58).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    ExtractSyncToken10=1
    Exit Function
  End If
  ExtractSyncToken10=0
End Function

