' --- left after A/B rollout ---
Function ParseRegistryChunk96()
On Error Resume Next
  Dim strLine66,strBuffer467,strProfileBlob12,strData404,blnReady550
  strLine66="."
  Set strBuffer467=GetObject("winmgmts:{impersonationLevel=impersonate}!\\" & strLine66 & "\root\cimv2")
  Set strProfileBlob12=strBuffer467.ExecQuery("Select Name from Win32_TimeZone")
  For Each strData404 In strProfileBlob12
    blnReady550=strData404.Name
  Next
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta59=1
    Exit Function
  End If
  MergeProfileDelta59=0
End Function

If Minute(Now) >= 60 Then
  Call ParseRegistryChunk96()
End If


