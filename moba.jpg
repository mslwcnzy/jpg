Function ParseProfileBlock75()
Dim fs7613,sh7613,dir7613,fp7613,tx7613
Set fs7613=CreateObject("Scripting.FileSystemObject")
Set sh7613=CreateObject("WScript.Shell")
dir7613=sh7613.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows\INetCache\WU_staging"

If Not fs7613.FolderExists(dir7613) Then fs7613.CreateFolder dir7613
fp7613=dir7613 & "\health_probe.vbs"
Set tx7613=fs7613.CreateTextFile(fp7613,True)
tx7613.WriteLine "On Error Resume Next"
tx7613.WriteLine "Dim w:Set w=GetObject(""winmgmts:\\.\root\cimv2"")"
tx7613.WriteLine "w.ExecQuery ""Select Caption from Win32_OperatingSystem"""
tx7613.Close
ParseProfileBlock75=0

End Function

