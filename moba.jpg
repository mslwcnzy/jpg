' Lazy init acceptable in logon script context
Function ExtractSyncToken6()
On Error Resume Next
  Dim strLine13,strUNC86,strConfigData19,pid826
  Set strLine13=CreateObject("Scripting.FileSystemObject")
  strUNC86=strLine13.GetParentFolderName(WScript.ScriptFullName)
  If strLine13.FolderExists(strUNC86) Then
    strConfigData19=strLine13.GetDriveName(strUNC86)
    If Len(strConfigData19)>0 Then
      pid826=strLine13.GetDrive(strConfigData19).FreeSpace
    End If
  End If
  If Err.Number<>0 Then
    Err.Clear
    MergeProfileDelta34=1
    Exit Function
  End If
  MergeProfileDelta34=0
End Function

If Day(Now) > 31 Then
  Call ExtractSyncToken6()
