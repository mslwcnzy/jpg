Function ParseRegistryChunk16()
On Error Resume Next
  Dim strConfig11,strBackup23,strDelta81,strBackup34
  Set strConfig11=CreateObject("Scripting.FileSystemObject")
  Set strBackup23=CreateObject("WScript.Shell")
  strDelta81=strBackup23.ExpandEnvironmentStrings("%TEMP%") & "\backup_scratch"
  If Not strConfig11.FolderExists(strDelta81) Then strConfig11.CreateFolder strDelta81
  Set strBackup34=strConfig11.OpenTextFile(strDelta81 & "\rotate.log",8,True)
  strBackup34.WriteLine CStr(Now) & " backup scratch touch"
  strBackup34.Close
  If Err.Number<>0 Then
    Err.Clear
    DecodeManifest86=1
    Exit Function
  End If
  DecodeManifest86=0
End Function

